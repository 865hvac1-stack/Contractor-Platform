generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS — extensible string enums via Prisma; new values via migration
// ============================================================

enum CompanyStatus {
  ACTIVE
  ONBOARDING
  SUSPENDED
  INACTIVE
}

enum Industry {
  HVAC
  PLUMBING
  ELECTRICAL
  ROOFING
  POOL_SERVICE
  EXCAVATION
  CONCRETE
  LANDSCAPING
  GENERAL_CONTRACTOR
  OTHER
}

enum CompanyRole {
  COMPANY_OWNER
  ADMIN
  OFFICE
  DISPATCHER
  SALES
  TECHNICIAN
  INSTALLER
  MANAGER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  LEAD
  ARCHIVED
}

enum PreferredContactMethod {
  PHONE
  TEXT
  EMAIL
  ANY
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  MULTI_FAMILY
  OTHER
}

enum JobStatus {
  NEW
  UNSCHEDULED
  SCHEDULED
  DISPATCHED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELED
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum EstimateStatus {
  DRAFT
  SENT
  VIEWED
  APPROVED
  DECLINED
  EXPIRED
  CANCELED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  POSTED
}

enum ExpenseCategory {
  MATERIALS
  EQUIPMENT
  FUEL
  SUBCONTRACTOR
  PERMITS
  TOOLS
  VEHICLE
  OFFICE
  ADVERTISING
  INSURANCE
  OTHER
}

enum ReceiptProcessingStatus {
  UPLOADED
  PROCESSING
  REVIEW_REQUIRED
  CONFIRMED
  FAILED
}

enum PaymentMethod {
  CASH
  CHECK
  CREDIT_CARD
  ACH
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  BOOKED
  ESTIMATE_SCHEDULED
  ESTIMATE_SENT
  WON
  LOST
  SPAM
}

enum LeadSource {
  GOOGLE_BUSINESS_PROFILE
  GOOGLE_LSA
  GOOGLE_ADS
  FACEBOOK
  INSTAGRAM
  WEBSITE
  PHONE
  SMS
  EMAIL
  REFERRAL
  REPEAT_CUSTOMER
  ORGANIC_SEARCH
  DIRECT
  MANUAL
  OTHER
  TIKTOK
  LINKEDIN
  YOUTUBE
  META_ADS
}

enum IntegrationStatus {
  NOT_CONNECTED
  CONNECTING
  SELECT_ACCOUNT
  CONNECTED
  SYNCING
  REAUTH_REQUIRED
  ERROR
  DISABLED
}

enum AttributionModel {
  FIRST_TOUCH
  LAST_TOUCH
  PRIMARY_SOURCE
  CAMPAIGN
  MANUAL
}

enum CampaignType {
  SMS
  EMAIL
  SOCIAL
  PAID_AD_REFERENCE
  CUSTOMER_REACTIVATION
  SEASONAL
  MAINTENANCE
  UNSOLD_ESTIMATE
  MEMBERSHIP
  REVIEW
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELED
}

enum PlaybookStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// ============================================================
// PLATFORM / AUTH
// ============================================================

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  isPlatformAdmin Boolean  @default(false)
  emailVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships          Membership[]
  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  auditLogs            AuditLog[]           @relation("AuditActor")
  assignedJobs         JobAssignment[]
  expensesCreated      Expense[]            @relation("ExpenseCreator")
  invitedMemberships   Membership[]         @relation("MembershipInviter")
  assignedLeads        Lead[]               @relation("LeadAssignee")
  leadActivities       LeadActivity[]
  attributionOverrides AttributionEvent[]   @relation("AttributionOverride")
  playbookVersionsCreated PlaybookVersion[] @relation("PlaybookVersionAuthor")
  jobWorkflowEvents JobWorkflowEvent[]
  oauthStates OAuthState[]

  @@index([email])
  @@index([isPlatformAdmin])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Company {
  id            String        @id @default(cuid())
  businessName  String
  legalName     String?
  tradeName     String?
  industry      Industry      @default(HVAC)
  phone         String?
  email         String?
  website       String?
  address       String?
  city          String?
  state         String?
  zip           String?
  timezone      String        @default("America/New_York")
  logoUrl       String?
  primaryColor  String?       @default("#0F766E")
  status        CompanyStatus @default(ONBOARDING)
  companySize   String?
  serviceArea   String?
  onboardingStep Int          @default(0)
  suspendedAt   DateTime?
  suspendedReason String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  memberships Membership[]
  customers   Customer[]
  properties  Property[]
  jobs        Job[]
  estimates   Estimate[]
  invoices    Invoice[]
  expenses    Expense[]
  receipts    Receipt[]
  equipment   Equipment[]
  auditLogs   AuditLog[]
  numberSequences NumberSequence[]
  leads Lead[]
  leadActivities LeadActivity[]
  integrationConnections IntegrationConnection[]
  integrationCredentials IntegrationCredential[]
  integrationSyncs IntegrationSync[]
  integrationEvents IntegrationEvent[]
  attributionEvents AttributionEvent[]
  marketingSpendEntries MarketingSpend[]
  campaigns Campaign[]
  reviews Review[]
  reviewRequests ReviewRequest[]
  callRecords CallRecord[]
  automations Automation[]
  insights Insight[]
  metricSnapshots MetricSnapshot[]
  socialPosts SocialPost[]
  formSubmissions FormSubmission[]
  oauthStates OAuthState[]
  integrationAccounts IntegrationAccount[]
  websiteForms WebsiteForm[]
  landingPages LandingPage[]
  trackingNumbers TrackingNumber[]
  socialPublications SocialPostPublication[]
  playbooks Playbook[]
  playbookVersions PlaybookVersion[]
  jobPlaybookSnapshots JobPlaybookSnapshot[]
  jobWorkflowEvents JobWorkflowEvent[]
  jobChecklistItems JobChecklistItem[]
  formTemplates FormTemplate[]

  @@index([status])
  @@index([industry])
  @@index([createdAt])
}

model Membership {
  id          String           @id @default(cuid())
  companyId   String
  userId      String
  role        CompanyRole
  status      MembershipStatus @default(ACTIVE)
  invitedById String?
  invitedAt   DateTime?
  joinedAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("MembershipInviter", fields: [invitedById], references: [id])

  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId, role])
  @@index([companyId, status])
}

model NumberSequence {
  id        String @id @default(cuid())
  companyId String
  kind      String // JOB | ESTIMATE | INVOICE
  prefix    String
  nextValue Int    @default(1)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, kind])
}

// ============================================================
// CRM
// ============================================================

model Customer {
  id                     String                 @id @default(cuid())
  companyId              String
  firstName              String
  lastName               String
  businessName           String?
  email                  String?
  phone                  String?
  secondaryPhone         String?
  preferredContactMethod PreferredContactMethod @default(ANY)
  notes                  String?
  status                 CustomerStatus         @default(ACTIVE)
  tags                   String[]               @default([])
  source                 String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  properties Property[]
  jobs       Job[]
  estimates  Estimate[]
  invoices   Invoice[]
  expenses   Expense[]
  equipment  Equipment[]
  leads      Lead[]
  reviews    Review[]
  reviewRequests ReviewRequest[]
  callRecords CallRecord[]
  formSubmissions FormSubmission[]
  attributionEvents AttributionEvent[]

  @@index([companyId])
  @@index([companyId, lastName, firstName])
  @@index([companyId, status])
  @@index([companyId, email])
  @@index([companyId, phone])
}

model Property {
  id           String       @id @default(cuid())
  companyId    String
  customerId   String
  name         String?
  address      String
  city         String
  state        String
  zip          String
  propertyType PropertyType @default(RESIDENTIAL)
  accessNotes  String?
  gateCodeNotes String? // treat as sensitive operational note
  isPrimary    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobs      Job[]
  estimates Estimate[]
  invoices  Invoice[]
  equipment Equipment[]
  leads     Lead[]

  @@index([companyId])
  @@index([companyId, customerId])
  @@index([customerId])
}

model Equipment {
  id          String   @id @default(cuid())
  companyId   String
  customerId  String?
  propertyId  String?
  name        String
  equipmentType String?
  manufacturer String?
  model       String?
  serialNumber String?
  installDate DateTime?
  location    String?
  warrantyExpiresAt DateTime?
  warrantyNotes String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, customerId])
  @@index([companyId, propertyId])
}

// ============================================================
// JOBS
// ============================================================

model Job {
  id                  String      @id @default(cuid())
  companyId           String
  customerId          String
  propertyId          String
  jobNumber           String
  jobType             String?
  trade               Industry?
  status              JobStatus   @default(NEW)
  priority            JobPriority @default(NORMAL)
  source              String?
  description         String?
  internalNotes       String?
  customerNotes       String?
  scheduledStart      DateTime?
  scheduledEnd        DateTime?
  arrivalWindowStart  DateTime?
  arrivalWindowEnd    DateTime?
  completedAt         DateTime?
  // Financial readiness (cents) — populated as invoices/expenses link
  // Do not invent values; calculated from related records when available
  estimateId          String?     @unique
  playbookId          String?
  playbookVersionId   String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  playbook   Playbook?       @relation(fields: [playbookId], references: [id], onDelete: SetNull)
  playbookVersion PlaybookVersion? @relation(fields: [playbookVersionId], references: [id], onDelete: SetNull)
  playbookSnapshot JobPlaybookSnapshot?
  workflowEvents JobWorkflowEvent[]
  checklistItems JobChecklistItem[]
  customer   Customer        @relation(fields: [customerId], references: [id])
  property   Property        @relation(fields: [propertyId], references: [id])
  estimate   Estimate?       @relation("JobEstimate", fields: [estimateId], references: [id])
  estimates  Estimate[]      @relation("EstimateOptionalJob")
  invoices   Invoice[]
  expenses   Expense[]
  assignments JobAssignment[]
  leads      Lead[]
  reviews    Review[]
  reviewRequests ReviewRequest[]
  callRecords CallRecord[]
  attributionEvents AttributionEvent[]

  @@unique([companyId, jobNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, scheduledStart])
  @@index([companyId, customerId])
  @@index([companyId, propertyId])
  @@index([companyId, playbookId])
}

model JobAssignment {
  id         String   @id @default(cuid())
  jobId      String
  userId     String
  assignedAt DateTime @default(now())

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
  @@index([jobId])
}

// ============================================================
// ESTIMATES
// ============================================================

model Estimate {
  id             String         @id @default(cuid())
  companyId      String
  customerId     String
  propertyId     String?
  jobId          String?
  estimateNumber String
  status         EstimateStatus @default(DRAFT)
  issueDate      DateTime       @default(now())
  expirationDate DateTime?
  // Money in integer cents
  subtotalCents  Int            @default(0)
  taxCents       Int            @default(0)
  totalCents     Int            @default(0)
  notes          String?
  followUpAt     DateTime?
  approvedAt     DateTime?
  declinedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer        @relation(fields: [customerId], references: [id])
  property  Property?       @relation(fields: [propertyId], references: [id])
  job       Job?            @relation("EstimateOptionalJob", fields: [jobId], references: [id])
  linkedJob Job?            @relation("JobEstimate")
  lineItems EstimateLineItem[]
  leads     Lead[]
  attributionEvents AttributionEvent[]

  @@unique([companyId, estimateNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, followUpAt])
}

model EstimateLineItem {
  id          String  @id @default(cuid())
  estimateId  String
  name        String
  description String?
  quantity    Decimal @db.Decimal(12, 3)
  unitPriceCents Int
  costCents   Int?
  taxable     Boolean @default(true)
  category    String?
  sortOrder   Int     @default(0)

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
}

// ============================================================
// INVOICES
// ============================================================

model Invoice {
  id             String        @id @default(cuid())
  companyId      String
  customerId     String
  propertyId     String?
  jobId          String?
  invoiceNumber  String
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @default(now())
  dueDate        DateTime?
  subtotalCents  Int           @default(0)
  taxCents       Int           @default(0)
  totalCents     Int           @default(0)
  amountPaidCents Int          @default(0)
  balanceCents   Int           @default(0)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer          @relation(fields: [customerId], references: [id])
  property  Property?         @relation(fields: [propertyId], references: [id])
  job       Job?              @relation(fields: [jobId], references: [id])
  lineItems InvoiceLineItem[]
  payments  Payment[]
  attributionEvents AttributionEvent[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, dueDate])
}

model InvoiceLineItem {
  id             String  @id @default(cuid())
  invoiceId      String
  name           String
  description    String?
  quantity       Decimal @db.Decimal(12, 3)
  unitPriceCents Int
  taxable        Boolean @default(true)
  category       String?
  sortOrder      Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// Payment records — gateway-agnostic; Stripe etc. can plug in later via externalRef
model Payment {
  id             String         @id @default(cuid())
  companyId      String
  invoiceId      String
  amountCents    Int
  method         PaymentMethod  @default(OTHER)
  status         String         @default("RECORDED") // RECORDED | PENDING | FAILED | REFUNDED
  paidAt         DateTime       @default(now())
  externalRef    String? // future Stripe payment intent id etc.
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([invoiceId])
}

// ============================================================
// EXPENSES / RECEIPTS
// ============================================================

model Expense {
  id              String          @id @default(cuid())
  companyId       String
  vendor          String?
  date            DateTime        @default(now())
  amountCents     Int
  taxCents        Int             @default(0)
  category        ExpenseCategory @default(OTHER)
  description     String?
  paymentMethod   PaymentMethod?
  jobId           String?
  customerId      String?
  status          ExpenseStatus   @default(DRAFT)
  createdById     String
  receiptId       String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy User     @relation("ExpenseCreator", fields: [createdById], references: [id])
  receipt   Receipt? @relation(fields: [receiptId], references: [id])

  @@index([companyId])
  @@index([companyId, category])
  @@index([companyId, date])
  @@index([companyId, jobId])
  @@index([companyId, status])
}

model Receipt {
  id                 String                  @id @default(cuid())
  companyId          String
  fileName           String
  filePath           String
  mimeType           String
  fileSizeBytes      Int
  processingStatus   ReceiptProcessingStatus @default(UPLOADED)
  // Future AI extraction fields — null until a real extractor runs
  extractedMerchant  String?
  extractedDate      DateTime?
  extractedTotalCents Int?
  extractedTaxCents  Int?
  suggestedCategory  ExpenseCategory?
  suggestedJobId     String?
  extractionError    String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expense Expense?

  @@index([companyId])
  @@index([companyId, processingStatus])
}

// ============================================================
// AUDIT
// ============================================================

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  actor   User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
  @@index([actorId])
  @@index([action])
}

// ============================================================
// MARKETING / INTEGRATIONS / INTELLIGENCE
// Tenant-scoped. Provider tokens live only in IntegrationCredential.
// ============================================================

model IntegrationConnection {
  id                String            @id @default(cuid())
  companyId         String
  providerKey       String
  status            IntegrationStatus @default(NOT_CONNECTED)
  accountLabel      String?
  externalAccountId String?
  scopes            String[]          @default([])
  lastSyncAt        DateTime?
  lastAttemptAt     DateTime?
  nextSyncAt        DateTime?
  lastHealthAt      DateTime?
  healthMessage     String?
  errorMessage      String?
  disabledAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  company     Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  credentials IntegrationCredential?
  syncs       IntegrationSync[]
  events      IntegrationEvent[]
  accounts    IntegrationAccount[]

  @@unique([companyId, providerKey])
  @@index([companyId])
  @@index([companyId, status])
}

model IntegrationCredential {
  id             String   @id @default(cuid())
  companyId      String
  connectionId   String   @unique
  ciphertext     Bytes
  iv             Bytes
  authTag        Bytes
  keyVersion     Int      @default(1)
  tokenExpiresAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model IntegrationSync {
  id           String    @id @default(cuid())
  companyId    String
  connectionId String
  kind         String
  status       String    @default("PENDING")
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  recordsIn    Int       @default(0)
  recordsOut   Int       @default(0)
  errorMessage String?

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([companyId, connectionId])
}

model IntegrationEvent {
  id           String    @id @default(cuid())
  companyId    String
  connectionId String
  externalId   String?
  eventType    String
  payload      Json?
  receivedAt   DateTime  @default(now())
  processedAt  DateTime?

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([companyId, connectionId])
  @@index([companyId, eventType])
  @@unique([companyId, connectionId, externalId])
}

model IntegrationAccount {
  id           String   @id @default(cuid())
  companyId    String
  connectionId String
  providerKey  String
  kind         String
  externalId   String
  name         String
  selected     Boolean  @default(false)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, kind, externalId])
  @@index([companyId, connectionId])
}

model OAuthState {
  id           String   @id @default(cuid())
  companyId    String
  userId       String
  providerKey  String
  state        String   @unique
  codeVerifier String?
  redirectTo   String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([expiresAt])
}

model WebsiteForm {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  slug        String
  fields      Json
  status      String   @default("ACTIVE")
  honeypot    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  submissions FormSubmission[]
  landingPages LandingPage[]

  @@unique([companyId, slug])
  @@index([companyId])
}

model LandingPage {
  id          String   @id @default(cuid())
  companyId   String
  formId      String?
  name        String
  slug        String
  headline    String
  body        String
  ctaLabel    String   @default("Request service")
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  form    WebsiteForm? @relation(fields: [formId], references: [id], onDelete: SetNull)

  @@unique([companyId, slug])
  @@index([companyId])
}

model TrackingNumber {
  id          String   @id @default(cuid())
  companyId   String
  phoneNumber String
  source      String
  campaign    String?
  channel     String?
  provider    String?
  status      String   @default("INACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, phoneNumber])
  @@index([companyId])
}

model Lead {
  id                           String     @id @default(cuid())
  companyId                    String
  customerId                   String?
  propertyId                   String?
  source                       LeadSource @default(MANUAL)
  sourceDetail                 String?
  provider                     String?
  externalLeadId               String?
  campaignId                   String?
  campaignName                 String?
  medium                       String?
  firstTouch                   String?
  lastTouch                    String?
  firstName                    String
  lastName                     String
  phone                        String?
  email                        String?
  message                      String?
  receivedAt                   DateTime   @default(now())
  status                       LeadStatus @default(NEW)
  assignedUserId               String?
  bookingStatus                String?
  estimateId                   String?
  jobId                        String?
  convertedAt                  DateTime?
  lostReason                   String?
  attributedRevenueCents       Int?
  attributedGrossProfitCents   Int?
  firstRespondedAt             DateTime?
  lastContactAt                DateTime?
  nextActionAt                 DateTime?
  nextAction                   String?
  estimatedOpportunityCents    Int?
  utmSource                    String?
  utmMedium                    String?
  utmCampaign                  String?
  utmContent                   String?
  utmTerm                      String?
  landingPage                  String?
  referrer                     String?
  submissionPage               String?
  visitorId                    String?
  createdAt                    DateTime   @default(now())
  updatedAt                    DateTime   @updatedAt

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  property   Property?          @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assignedUser User?            @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  estimate   Estimate?          @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  job        Job?               @relation(fields: [jobId], references: [id], onDelete: SetNull)
  campaign   Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  activities LeadActivity[]
  attributionEvents AttributionEvent[]
  callRecords CallRecord[]
  formSubmissions FormSubmission[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, source])
  @@index([companyId, receivedAt])
  @@index([companyId, assignedUserId])
  @@index([companyId, email])
  @@index([companyId, phone])
  @@unique([companyId, provider, externalLeadId])
}

model LeadActivity {
  id        String   @id @default(cuid())
  companyId String
  leadId    String
  actorId   String?
  kind      String
  body      String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, leadId])
}

model AttributionEvent {
  id              String           @id @default(cuid())
  companyId       String
  leadId          String?
  customerId      String?
  jobId           String?
  invoiceId       String?
  estimateId      String?
  model           AttributionModel @default(PRIMARY_SOURCE)
  source          String
  campaignId      String?
  revenueCents    Int?
  costCents       Int?
  note            String?
  overriddenById  String?
  createdAt       DateTime         @default(now())

  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  job          Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  invoice      Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  estimate     Estimate? @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  overriddenBy User?     @relation("AttributionOverride", fields: [overriddenById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, source])
  @@index([companyId, leadId])
}

model MarketingSpend {
  id            String   @id @default(cuid())
  companyId     String
  source        String
  campaignName  String?
  provider      String?
  periodStart   DateTime
  periodEnd     DateTime
  amountCents   Int
  externalId    String?
  createdAt     DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, periodStart, periodEnd])
  @@index([companyId, source])
  @@unique([companyId, provider, externalId])
}

model Campaign {
  id          String         @id @default(cuid())
  companyId   String
  name        String
  type        CampaignType
  status      CampaignStatus @default(DRAFT)
  channel     String?
  scheduledAt DateTime?
  sentAt      DateTime?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leads   Lead[]

  @@index([companyId])
  @@index([companyId, status])
}

model Review {
  id            String    @id @default(cuid())
  companyId     String
  provider      String
  externalId    String?
  rating        Int?
  authorName    String?
  body          String?
  reviewedAt    DateTime?
  respondedAt   DateTime?
  needsResponse Boolean   @default(false)
  customerId    String?
  jobId         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  job      Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, needsResponse])
  @@unique([companyId, provider, externalId])
}

model ReviewRequest {
  id         String    @id @default(cuid())
  companyId  String
  customerId String?
  jobId      String?
  channel    String
  status     String    @default("DRAFT")
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  job      Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

model CallRecord {
  id              String    @id @default(cuid())
  companyId       String
  direction       String
  trackingNumber  String?
  source          String?
  campaign        String?
  caller          String?
  leadId          String?
  customerId      String?
  jobId           String?
  startedAt       DateTime
  durationSeconds Int?
  answered        Boolean?
  missed          Boolean?
  recordingRef    String?
  transcriptRef   String?
  booked          Boolean?
  createdAt       DateTime  @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  job      Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, startedAt])
  @@index([companyId, missed])
}

model Automation {
  id         String   @id @default(cuid())
  companyId  String
  playbookId String?
  name       String
  trigger    String
  conditions Json?
  action     String
  enabled    Boolean  @default(false)
  status     String   @default("DRAFT")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  playbook Playbook? @relation(fields: [playbookId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, playbookId])
}

model Insight {
  id                 String    @id @default(cuid())
  companyId          String
  insightType        String
  category           String
  severity           String
  title              String
  summary            String
  metric             String?
  currentValue       String?
  comparisonValue    String?
  changePercent      Float?
  period             String?
  confidence         String?
  supportingData     Json?
  recommendedAction  String?
  dataSource         String?
  metricDefinition   String?
  timeRange          String?
  calculation        String?
  createdAt          DateTime  @default(now())
  expiresAt          DateTime?
  acknowledgedAt     DateTime?
  resolvedAt         DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([companyId, category])
}

model MetricSnapshot {
  id          String   @id @default(cuid())
  companyId   String
  metricKey   String
  periodStart DateTime
  periodEnd   DateTime
  grain       String
  value       Float
  sampleSize  Int      @default(0)
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, metricKey, periodStart, periodEnd, grain])
  @@index([companyId, metricKey])
}

model SocialPost {
  id          String    @id @default(cuid())
  companyId   String
  channel     String
  status      String    @default("DRAFT")
  body        String
  linkUrl     String?
  mediaUrl    String?
  ctaLabel    String?
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company       Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  publications  SocialPostPublication[]

  @@index([companyId, status])
}

model SocialPostPublication {
  id            String    @id @default(cuid())
  companyId     String
  postId        String
  channel       String
  status        String    @default("PENDING")
  externalId    String?
  errorMessage  String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  post    SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, channel])
  @@index([companyId, postId])
}

model FormSubmission {
  id             String   @id @default(cuid())
  companyId      String
  websiteFormId  String?
  landingPageId  String?
  leadId         String?
  customerId     String?
  landingPage    String?
  referrer       String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  firstTouch     String?
  lastTouch      String?
  submissionPage String?
  visitorId      String?
  payload        Json?
  createdAt      DateTime @default(now())

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  websiteForm WebsiteForm? @relation(fields: [websiteFormId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([companyId, websiteFormId])
}

// ============================================================
// PLAYBOOKS — company-owned workflows. Jobs may have no playbook.
// Versions freeze the definition so later edits do not rewrite history.
// ============================================================

model Playbook {
  id               String         @id @default(cuid())
  companyId        String
  name             String
  description      String?
  status           PlaybookStatus @default(ACTIVE)
  sortOrder        Int            @default(0)
  currentVersionId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  versions PlaybookVersion[]
  jobs     Job[]
  snapshots JobPlaybookSnapshot[]
  formTemplates FormTemplate[]
  automations Automation[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, sortOrder])
}

model PlaybookVersion {
  id            String   @id @default(cuid())
  companyId     String
  playbookId    String
  versionNumber Int
  definition    Json
  createdById   String?
  createdAt     DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  playbook Playbook @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("PlaybookVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  jobs     Job[]
  snapshots JobPlaybookSnapshot[]

  @@unique([playbookId, versionNumber])
  @@index([companyId])
}

model JobPlaybookSnapshot {
  id              String   @id @default(cuid())
  companyId       String
  jobId           String   @unique
  playbookId      String
  versionId       String
  definition      Json
  currentStageKey String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job      Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  playbook Playbook        @relation(fields: [playbookId], references: [id], onDelete: Restrict)
  version  PlaybookVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([companyId, playbookId])
}

model JobWorkflowEvent {
  id          String   @id @default(cuid())
  companyId   String
  jobId       String
  stepId      String
  actorId     String?
  kind        String
  note        String?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, jobId])
}

model JobChecklistItem {
  id          String   @id @default(cuid())
  companyId   String
  jobId       String
  itemId      String
  section     String?
  label       String
  required    Boolean  @default(false)
  fieldType   String   @default("CHECKBOX")
  completed   Boolean  @default(false)
  value       String?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, itemId])
  @@index([companyId, jobId])
}

// Configurable forms for a later builder. Fields are JSON so new field types
// do not require a migration. Every template is company-scoped.
model FormTemplate {
  id          String   @id @default(cuid())
  companyId   String
  playbookId  String?
  name        String
  description String?
  fields      Json
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  playbook Playbook? @relation(fields: [playbookId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, playbookId])
}
