  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category TechnicianJobCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  ratings  TechnicianSkillRating[]

  @@unique([companyId, key])
  @@index([companyId, active, group, sortOrder])
}

model TechnicianSkillRating {
  id          String   @id @default(cuid())
  companyId   String
  profileId   String
  skillId     String
  rating      Int
  managerNote String?  @db.Text
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  profile TechnicianIntelligenceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   TechnicianSkillDefinition     @relation(fields: [skillId], references: [id], onDelete: Restrict)
  updatedBy User                         @relation("TechnicianSkillRatingUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([profileId, skillId])
  @@index([companyId, skillId, rating])
}

model TechnicianQualificationDefinition {
  id        String   @id @default(cuid())
  companyId String
  key       String
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company                        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  qualifications TechnicianQualification[]
  requirements   TechnicianJobTypeRequirement[]

  @@unique([companyId, key])
  @@index([companyId, active, sortOrder])
}

model TechnicianQualification {
  id                  String    @id @default(cuid())
  companyId           String
  profileId           String
  definitionId        String
  status              String    @default("ACTIVE")
  issuedDate          DateTime? @db.Date
  expirationDate      DateTime? @db.Date
  certificationNumber String?
  documentId          String?
  notes               String?   @db.Text
  createdById         String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company    Company                           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  profile    TechnicianIntelligenceProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  definition TechnicianQualificationDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  createdBy  User                              @relation("TechnicianQualificationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([profileId, definitionId])
  @@index([companyId, definitionId, status, expirationDate])
}

model TechnicianJobTypeRequirement {
  id                        String   @id @default(cuid())
  companyId                 String
  categoryId                String
  qualificationDefinitionId String
  createdById               String
  createdAt                 DateTime @default(now())

  company       Company                           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category      TechnicianJobCategory             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  qualification TechnicianQualificationDefinition @relation(fields: [qualificationDefinitionId], references: [id], onDelete: Cascade)

  @@unique([categoryId, qualificationDefinitionId])
  @@index([companyId, categoryId])
}

model TechnicianCallPreference {
  id          String   @id @default(cuid())
  companyId   String
  profileId   String
  categoryId  String
  preference  String
  reason      String?  @db.Text
  changedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  profile   TechnicianIntelligenceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category  TechnicianJobCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  changedBy User                          @relation("TechnicianPreferenceActor", fields: [changedById], references: [id], onDelete: Restrict)

  @@unique([profileId, categoryId])
  @@index([companyId, categoryId, preference])
}

model TechnicianPerformanceAggregate {
  id                       String    @id @default(cuid())
  companyId                String
  profileId                String
  categoryId               String
  window                   String
  windowStart              DateTime?
  windowEnd                DateTime?
  completedJobs            Int       @default(0)
  recognizedRevenueCents   Int       @default(0)
  invoiceCount             Int       @default(0)
  callbackCount            Int       @default(0)
  firstTimeCompletionCount Int       @default(0)
  validDurationCount       Int       @default(0)
  totalDurationMinutes     Int       @default(0)
  estimatePresentedCount   Int       @default(0)
  estimateApprovedCount    Int       @default(0)
  confidence               String    @default("INSUFFICIENT")
  calculatedAt             DateTime  @default(now())
  sourceThrough            DateTime?

  company  Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  profile  TechnicianIntelligenceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category TechnicianJobCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([profileId, categoryId, window])
  @@index([companyId, categoryId, window, completedJobs])
}

model TechnicianIntelligenceOverride {
  id          String   @id @default(cuid())
  companyId   String
  profileId   String
  categoryId  String?
  kind        String
  active      Boolean  @default(true)
  reason      String   @db.Text
  changedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  profile   TechnicianIntelligenceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category  TechnicianJobCategory?        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  changedBy User                          @relation("TechnicianIntelligenceOverrideActor", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([companyId, profileId, active])
  @@index([companyId, categoryId, active])
}

model TechnicianJobRelationship {
  id            String   @id @default(cuid())
  companyId     String
  originalJobId String
  relatedJobId  String
  type          String
  reason        String?
  createdById   String
  createdAt     DateTime @default(now())

  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  originalJob Job     @relation("TechnicianOriginalJob", fields: [originalJobId], references: [id], onDelete: Cascade)
  relatedJob  Job     @relation("TechnicianRelatedJob", fields: [relatedJobId], references: [id], onDelete: Cascade)
  createdBy   User    @relation("TechnicianJobRelationshipCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([companyId, originalJobId, relatedJobId, type])
  @@index([companyId, originalJobId, type])
  @@index([companyId, relatedJobId, type])
}
