enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  POSTED
}

enum ExpenseCategory {
  MATERIALS
  EQUIPMENT
  FUEL
  SUBCONTRACTOR
  PERMITS
  TOOLS
  VEHICLE
  OFFICE
  ADVERTISING
  INSURANCE
  OTHER
