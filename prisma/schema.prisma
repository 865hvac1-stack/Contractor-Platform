// ============================================================
// PROJECTS — multi-day orchestration over existing Jobs
// ============================================================

model Project {
  id                       String    @id @default(cuid())
  companyId                String
  customerId               String
  propertyId               String
  projectNumber            String
  name                     String
  type                     String    @default("CUSTOM")
  status                   String    @default("PLANNING")
  builderName              String?
  primaryContactName       String?
  primaryContactPhone      String?
  projectManagerId         String?
  nextStep                 String?
  nextStepOverride         Boolean   @default(false)
  originalContractCents    Int       @default(0)
  laborBudgetMinutes       Int?
  laborBudgetCostCents     Int?
  equipmentBudgetCents     Int?
  materialsBudgetCents     Int?
  otherBudgetCents         Int?
  estimatedStart           DateTime?
  targetCompletion         DateTime?
  actualStart              DateTime?
  completedAt              DateTime?
  completionOverrideReason String?
  finalSnapshot            Json?
  minimumMarginBps         Int       @default(2000)
  createdById              String
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  company           Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer          Customer                  @relation("ProjectCustomer", fields: [customerId], references: [id])
  property          Property                  @relation(fields: [propertyId], references: [id])
  phases            ProjectPhase[]
  jobs              Job[]
  laborEntries      ProjectLaborEntry[]
  costs             ProjectCost[]
  materials         ProjectMaterial[]
  materialRequests  ProjectMaterialRequest[]
  assets            ProjectAsset[]
  receipts          Receipt[]
  issues            ProjectIssue[]
  changeOrders      ProjectChangeOrder[]
  billingMilestones ProjectBillingMilestone[]
  invoices          Invoice[]
  activities        ProjectActivity[]
  contacts          ProjectContact[]

  @@unique([companyId, projectNumber])
  @@index([companyId, status, updatedAt])
  @@index([companyId, customerId])
  @@index([companyId, propertyId])
  @@index([companyId, type])
  @@index([companyId, projectManagerId])
}

model ProjectPhase {
  id                     String    @id @default(cuid())
  companyId              String
  projectId              String
  name                   String
