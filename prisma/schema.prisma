// ============================================================
// PLAYBOOKS — company-owned workflows. Jobs may have no playbook.
// Versions freeze the definition so later edits do not rewrite history.
// ============================================================

model Playbook {
  id               String         @id @default(cuid())
  companyId        String
  name             String
  description      String?
  status           PlaybookStatus @default(ACTIVE)
  sortOrder        Int            @default(0)
  currentVersionId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceTypes ServiceType[]
  versions PlaybookVersion[]
  jobs     Job[]
  snapshots JobPlaybookSnapshot[]
  formTemplates FormTemplate[]
  automations Automation[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, sortOrder])
}

model PlaybookVersion {
  id            String   @id @default(cuid())
  companyId     String
  playbookId    String
  versionNumber Int
  definition    Json
  createdById   String?
  createdAt     DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  playbook Playbook @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("PlaybookVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  jobs     Job[]
  snapshots JobPlaybookSnapshot[]

  @@unique([playbookId, versionNumber])
  @@index([companyId])
}

model JobPlaybookSnapshot {
  id              String   @id @default(cuid())
  companyId       String
  jobId           String   @unique
  playbookId      String
  versionId       String
  definition      Json
  currentStageKey String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job      Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  playbook Playbook        @relation(fields: [playbookId], references: [id], onDelete: Restrict)
  version  PlaybookVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([companyId, playbookId])
}

model JobWorkflowEvent {
  id          String   @id @default(cuid())
  companyId   String
  jobId       String
  stepId      String
  actorId     String?
  kind        String
  note        String?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, jobId])
}

model JobChecklistItem {
  id          String   @id @default(cuid())
  companyId   String
  jobId       String
  itemId      String
  section     String?
  label       String
  required    Boolean  @default(false)
  fieldType   String   @default("CHECKBOX")
  completed   Boolean  @default(false)
  value       String?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, itemId])
  @@index([companyId, jobId])
}

// Configurable forms for a later builder. Fields are JSON so new field types
// do not require a migration. Every template is company-scoped.
model FormTemplate {
  id          String   @id @default(cuid())
  companyId   String
  playbookId  String?
  name        String
  description String?
  fields      Json
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  playbook Playbook? @relation(fields: [playbookId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, playbookId])
}

enum ImportRecordType {
  CUSTOMERS
  PROPERTIES
  CONTACTS
  JOBS
  ESTIMATES
  INVOICES
  PAYMENTS
  EQUIPMENT
  MEMBERSHIPS
  NOTES
  TAGS
  LEAD_SOURCES
  EXPENSES
  PRICEBOOK
  COMMUNICATIONS
  OTHER
}

enum ImportSourceType {
  HOUSECALL_PRO
  SERVICETITAN
  JOBBER
  FIELDEDGE
  SERVICE_FUSION
  WORKIZ
  QUICKBOOKS
  HUBSPOT
  SALESFORCE
  SPREADSHEET
  OTHER
  UNKNOWN
}

enum ImportSessionStatus {
  UPLOADED
  ANALYZING
  MAPPING_REQUIRED
  READY_FOR_PREVIEW
  READY_TO_IMPORT
  IMPORTING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum ImportRowStatus {
  PENDING
  VALID
  WARNING
  ERROR
  IMPORTED
  SKIPPED
  FAILED
}

enum ImportRowAction {
  CREATE
  UPDATE
  MERGE
  SKIP
  ERROR
}

enum ImportDuplicateVerdict {
  NEW
  LIKELY_DUPLICATE
  EXACT_MATCH
  NEEDS_REVIEW
}

model MigrationProject {
  id         String           @id @default(cuid())
  companyId  String
  name       String
  sourceType ImportSourceType @default(UNKNOWN)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions   ImportSession[]

  @@index([companyId, createdAt])
}

model ImportSession {
  id                 String              @id @default(cuid())
  companyId          String
  userId             String
  recordType         ImportRecordType
  sourceType         ImportSourceType
  fileName           String
  fileHash           String
  mimeType           String?
  encoding           String?
  status             ImportSessionStatus @default(UPLOADED)
  rowCount           Int                 @default(0)
  analysis           Json?
  mapping            Json?
  previewSummary     Json?
  importSummary      Json?
  intelligence       String?
  errorMessage       String?
  duplicatePolicy    String              @default("SKIP")
  importMode         String              @default("HISTORICAL")
  detectedRecordType ImportRecordType?
  rowAccounting      Json?
  qualityScore       Json?
  migrationProjectId String?
  confirmedAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  processedRows      Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  migrationProject   MigrationProject?   @relation(fields: [migrationProjectId], references: [id], onDelete: SetNull)
  rows               ImportRow[]
  externalRefs       ImportExternalRef[]
  createdCustomers   Customer[]
  createdProperties  Property[]
  createdJobs        Job[]
  createdEstimates   Estimate[]
  createdInvoices    Invoice[]
  createdPayments    Payment[]
  createdEquipment   Equipment[]
  createdExpenses    Expense[]

  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@index([companyId, migrationProjectId])
}

model ImportRow {
  id               String                 @id @default(cuid())
  companyId        String
  importSessionId  String
  rowNumber        Int
  status           ImportRowStatus        @default(PENDING)
  action           ImportRowAction        @default(CREATE)
  duplicateVerdict ImportDuplicateVerdict @default(NEW)
  rawData          Json
  normalizedData   Json?
  mappedData       Json?
  issues           Json?
  targetRecordId   String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  company          Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  session          ImportSession          @relation(fields: [importSessionId], references: [id], onDelete: Cascade)

  @@unique([importSessionId, rowNumber])
  @@index([companyId, importSessionId])
  @@index([importSessionId, status])
  @@index([companyId, targetRecordId])
}

model ImportExternalRef {
  id              String           @id @default(cuid())
  companyId       String
  sourceSystem    ImportSourceType
  recordType      ImportRecordType
  externalId      String
  targetRecordId  String
  importSessionId String?
  createdAt       DateTime         @default(now())
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  session         ImportSession?   @relation(fields: [importSessionId], references: [id], onDelete: SetNull)

  @@unique([companyId, sourceSystem, recordType, externalId])
  @@index([companyId, recordType, targetRecordId])
}

model ImportMappingProfile {
  id                String           @id @default(cuid())
  companyId         String?
  sourceType        ImportSourceType
  recordType        ImportRecordType
  name              String
  headerFingerprint String
  mapping           Json
  isSystem          Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  company           Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([sourceType, recordType])
}

// ============================================================
// PRICEBOOK / ESTIMATE OPTIONS / MEMBERSHIPS / COMPENSATION
// ============================================================

model PricebookCategory {
  id         String   @id @default(cuid())
  companyId  String
  parentId   String?
  name       String
  sortOrder  Int      @default(0)
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   PricebookCategory?  @relation("PricebookCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children PricebookCategory[] @relation("PricebookCategoryTree")
  items    PricebookItem[]

  @@index([companyId, archived])
  @@index([companyId, parentId])
}

model PricebookItem {
  id                  String            @id @default(cuid())
  companyId           String
  categoryId          String
  name                String
  internalName        String?
  sku                 String?
  type                PricebookItemType @default(SERVICE)
  customerDescription String?
  technicianNotes     String?
  standardPriceCents  Int
  memberPriceCents    Int?
  internalCostCents   Int?
  taxable             Boolean           @default(true)
  unit                String            @default("each")
  active              Boolean           @default(true)
  sortOrder           Int               @default(0)
  importMode          String            @default("LIVE")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category   PricebookCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  lineItems  EstimateLineItem[]

  @@index([companyId, active])
  @@index([companyId, categoryId])
  @@index([companyId, name])
  @@index([companyId, sku])
}

model EstimateOption {
  id          String   @id @default(cuid())
  companyId   String
  estimateId  String
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  estimate  Estimate           @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  lineItems EstimateLineItem[]

  @@index([companyId, estimateId])
}

model MembershipPlan {
  id               String   @id @default(cuid())
  companyId        String
  name             String
  description      String?
  priceCents       Int
  billingFrequency String   @default("ANNUAL")
  includedVisits   Int?
  discountPercent  Int      @default(0)
  priorityService  Boolean  @default(false)
  benefits         String?
  terms            String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  memberships  CustomerMembership[]

  @@index([companyId, active])
}

model CustomerMembership {
  id                String                    @id @default(cuid())
  companyId         String
  customerId        String
  propertyId        String?
  planId            String
  soldById          String?
  sourceJobId       String?
  sourceEstimateId  String?
  sourceInvoiceId   String?
  status            CustomerMembershipStatus  @default(PENDING)
  priceCents        Int
  saleDate          DateTime                  @default(now())
  startDate         DateTime?
  renewalDate       DateTime?
  visitsUsed        Int                       @default(0)
  importMode        String                    @default("LIVE")
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  property Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  plan     MembershipPlan  @relation(fields: [planId], references: [id], onDelete: Restrict)
  soldBy   User?           @relation("MembershipSoldBy", fields: [soldById], references: [id], onDelete: SetNull)
  job      Job?            @relation(fields: [sourceJobId], references: [id], onDelete: SetNull)
  estimate Estimate?       @relation(fields: [sourceEstimateId], references: [id], onDelete: SetNull)
  invoice  Invoice?        @relation(fields: [sourceInvoiceId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, soldById])
}

model CompensationRule {
  id            String               @id @default(cuid())
  companyId     String
  name          String
  type          CompensationRuleType
  trigger       CompensationTrigger
  amountCents   Int?
  percentBps    Int?
  minAmountCents Int?
  jobType       String?
  pricebookItemId String?
  membershipPlanId String?
  active        Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  company  Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  versions CompensationRuleVersion[]
  events   CompensationEvent[]

  @@index([companyId, active])
  @@index([companyId, trigger])
}

model CompensationRuleVersion {
  id         String   @id @default(cuid())
  companyId  String
  ruleId     String
  snapshot   Json
  createdAt  DateTime @default(now())

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rule    CompensationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  events  CompensationEvent[]

  @@index([companyId, ruleId])
}

model CompensationEvent {
  id                 String             @id @default(cuid())
  companyId          String
  userId             String
  ruleId             String
  ruleVersionId      String
  sourceType         String
  sourceId           String
  jobId              String?
  customerId         String?
  amountCents        Int
  calculationBasis   String
  status             CompensationStatus @default(PENDING)
  earnedAt           DateTime           @default(now())
  approvedAt         DateTime?
  paidAt             DateTime?
  approvedById       String?
  notes              String?
  importMode         String             @default("LIVE")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule        CompensationRule        @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  ruleVersion CompensationRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  approvedBy  User?                   @relation("CompensationApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  job         Job?                    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  customer    Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([companyId, ruleId, sourceType, sourceId, userId])
  @@index([companyId, userId, status])
  @@index([companyId, status, earnedAt])
}

model PerformanceGoal {
  id         String   @id @default(cuid())
  companyId  String
  userId     String?
  metricKey  String
  target     Int
  period     String   @default("WEEK")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, metricKey])
}
