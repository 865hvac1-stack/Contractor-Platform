generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS — extensible string enums via Prisma; new values via migration
// ============================================================

enum CompanyStatus {
  ACTIVE
  ONBOARDING
  SUSPENDED
  INACTIVE
}

enum Industry {
  HVAC
  PLUMBING
  ELECTRICAL
  ROOFING
  POOL_SERVICE
  EXCAVATION
  CONCRETE
  LANDSCAPING
  GENERAL_CONTRACTOR
  PAINTING
  FLOORING
  CLEANING
  PEST_CONTROL
  OTHER
}

enum CompanyRole {
  COMPANY_OWNER
  ADMIN
  OFFICE
  DISPATCHER
  SALES
  TECHNICIAN
  INSTALLER
  MANAGER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  LEAD
  ARCHIVED
}

enum PreferredContactMethod {
  PHONE
  TEXT
  EMAIL
  ANY
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  MULTI_FAMILY
  OTHER
}

enum JobStatus {
  NEW
  UNSCHEDULED
  SCHEDULED
  DISPATCHED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELED
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum EstimateStatus {
  DRAFT
  SENT
  VIEWED
  APPROVED
  DECLINED
  EXPIRED
  CANCELED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  REFUNDED
  PARTIALLY_REFUNDED
