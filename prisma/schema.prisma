}

enum AttributionModel {
  FIRST_TOUCH
  LAST_TOUCH
  PRIMARY_SOURCE
  CAMPAIGN
  MANUAL
}

enum CampaignType {
  SMS
  EMAIL
  SOCIAL
  PAID_AD_REFERENCE
  CUSTOMER_REACTIVATION
  SEASONAL
  MAINTENANCE
  UNSOLD_ESTIMATE
  MEMBERSHIP
  REVIEW
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELED
}

enum PlaybookStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// ============================================================
// PLATFORM / AUTH
// ============================================================

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  isPlatformAdmin Boolean  @default(false)
  loadedLaborCostCents Int?
  emailVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships          Membership[]
  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  teamInvitesSent      TeamInvite[]         @relation("TeamInviteSender")
  auditLogs            AuditLog[]           @relation("AuditActor")
  assignedJobs         JobAssignment[]
  expensesCreated      Expense[]            @relation("ExpenseCreator")
  invitedMemberships   Membership[]         @relation("MembershipInviter")
  assignedLeads        Lead[]               @relation("LeadAssignee")
  leadActivities       LeadActivity[]
  attributionOverrides AttributionEvent[]   @relation("AttributionOverride")
  playbookVersionsCreated PlaybookVersion[] @relation("PlaybookVersionAuthor")
  jobWorkflowEvents JobWorkflowEvent[]
  oauthStates OAuthState[]
  importSessions ImportSession[]
  receiptsUploaded Receipt[] @relation("ReceiptUploader")
  jobCostsCreated JobCost[] @relation("JobCostCreator")
  estimatesCreated Estimate[] @relation("EstimateCreator")
  paymentsRecorded Payment[] @relation("PaymentRecorder")
  membershipsSold CustomerMembership[] @relation("MembershipSoldBy")
  compensationEvents CompensationEvent[]
  compensationApprovals CompensationEvent[] @relation("CompensationApprover")
  jobPhotosUploaded JobPhoto[] @relation("JobPhotoUploader")
  customerNotesAuthored CustomerNote[] @relation("CustomerNoteAuthor")
  performanceGoals PerformanceGoal[]
  aiConversations AIConversation[]
  aiUsageEvents AIUsageEvent[]
  aiActionDrafts AIActionDraft[]
  aiActionsRequested AIActionRequest[] @relation("AIActionRequestedBy")
  aiActionsApproved AIActionRequest[] @relation("AIActionApprovedBy")
  companyTasksAssigned CompanyTask[] @relation("CompanyTaskAssignee")
  companyTasksCreated CompanyTask[] @relation("CompanyTaskCreator")

  @@index([email])
  @@index([isPlatformAdmin])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TeamInvite {
  id               String      @id @default(cuid())
  companyId        String
  email            String
  firstName        String
  lastName         String
  role             CompanyRole
  tokenHash        String      @unique
  invitedById      String
  userId           String?
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  lastEmailStatus  String?
  lastEmailError   String?
  lastEmailedAt    DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("TeamInviteSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([companyId, email])
  @@index([companyId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Company {
  id            String        @id @default(cuid())
  businessName  String
  legalName     String?
  tradeName     String?
  industry      Industry      @default(HVAC)
  phone         String?
  email         String?
  website       String?
  address       String?
  city          String?
  state         String?
  zip           String?
  timezone      String        @default("America/New_York")
  logoUrl       String?
  primaryColor  String?       @default("#0F766E")
  accentColor   String?
  tagline       String?
  description   String?
  hoursNote     String?
  isDemo        Boolean       @default(false)
  allowExternalIntegrationTesting Boolean @default(false)
  status        CompanyStatus @default(ONBOARDING)
  companySize   String?
  serviceArea   String?
  onboardingStep Int          @default(0)
  suspendedAt   DateTime?
  suspendedReason String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  memberships Membership[]
  customers   Customer[]
  properties  Property[]
  jobs        Job[]
  estimates   Estimate[]
  invoices    Invoice[]
  expenses    Expense[]
  receipts    Receipt[]
  equipment   Equipment[]
  auditLogs   AuditLog[]
  numberSequences NumberSequence[]
  leads Lead[]
  leadActivities LeadActivity[]
  integrationConnections IntegrationConnection[]
  integrationCredentials IntegrationCredential[]
  integrationSyncs IntegrationSync[]
  integrationEvents IntegrationEvent[]
  attributionEvents AttributionEvent[]
  marketingSpendEntries MarketingSpend[]
  campaigns Campaign[]
  reviews Review[]
  reviewRequests ReviewRequest[]
  callRecords CallRecord[]
  automations Automation[]
  insights Insight[]
  metricSnapshots MetricSnapshot[]
  socialPosts SocialPost[]
  formSubmissions FormSubmission[]
  oauthStates OAuthState[]
  integrationAccounts IntegrationAccount[]
  websiteForms WebsiteForm[]
  landingPages LandingPage[]
  trackingNumbers TrackingNumber[]
  socialPublications SocialPostPublication[]
  playbooks Playbook[]
  playbookVersions PlaybookVersion[]
  jobPlaybookSnapshots JobPlaybookSnapshot[]
  jobWorkflowEvents JobWorkflowEvent[]
  jobChecklistItems JobChecklistItem[]
  formTemplates FormTemplate[]
  aiConversations AIConversation[]
  aiMessages AIMessage[]
  aiUsageEvents AIUsageEvent[]
  aiActionDrafts AIActionDraft[]
  aiActionRequests AIActionRequest[]
  aiActionTargets AIActionTarget[]
  companyTasks CompanyTask[]
  intelligenceSetting CompanyIntelligenceSetting?
  importSessions ImportSession[]
  importRows ImportRow[]
  importExternalRefs ImportExternalRef[]
  importProfiles ImportMappingProfile[]
  migrationProjects MigrationProject[]
  vehicles Vehicle[]
  jobCosts JobCost[]
  quickBooksSettings QuickBooksSettings?
  quickBooksMappings QuickBooksMapping[]
  quickBooksSyncEvents QuickBooksSyncEvent[]
  pricebookCategories PricebookCategory[]
  pricebookItems PricebookItem[]
  membershipPlans MembershipPlan[]
  customerMemberships CustomerMembership[]
  estimateOptions EstimateOption[]
  compensationRules CompensationRule[]
  compensationRuleVersions CompensationRuleVersion[]
  compensationEvents CompensationEvent[]
  performanceGoals PerformanceGoal[]
  jobPhotos JobPhoto[]
  customerNotes CustomerNote[]
  teamInvites TeamInvite[]
  routeOptimizationRuns RouteOptimizationRun[]
  stripeConnectAccount StripeConnectAccount?
  stripeWebhookEvents StripeWebhookEvent[]
  serviceTypes ServiceType[]
  providerIdentityMaps ProviderIdentityMap[]
  communicationThreads CommunicationThread[]
  communicationMessages CommunicationMessage[]
  techDiscountLimitBps Int?
  routeStartKind String?
  routeEndKind String?
  providerTestGrantsAsTenant ProviderTestGrant[] @relation("ProviderTestGrantTenant")
  providerTestGrantsAsOwner  ProviderTestGrant[] @relation("ProviderTestGrantOwner")

  @@index([status])
  @@index([industry])
  @@index([createdAt])
  @@index([isDemo])
}

model Membership {
  id          String           @id @default(cuid())
  companyId   String
  userId      String
  role        CompanyRole
  status      MembershipStatus @default(ACTIVE)
  invitedById String?
  invitedAt   DateTime?
  joinedAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("MembershipInviter", fields: [invitedById], references: [id])
  assignedVehicleId String?
  assignedVehicle Vehicle? @relation(fields: [assignedVehicleId], references: [id], onDelete: SetNull)
  routeStartKind String?
  routeEndKind String?
  homeAddress String?
  homeCity String?
  homeState String?
  homeZip String?

  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId, role])
  @@index([companyId, status])
}

model NumberSequence {
  id        String @id @default(cuid())
  companyId String
  kind      String // JOB | ESTIMATE | INVOICE
  prefix    String
  nextValue Int    @default(1)
  padding   Int    @default(5)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, kind])
}

/// Company-scoped “what kind of work” catalog. Distinct from Pricebook items.
model ServiceType {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  key         String
  description String?
  playbookKey String?
  playbookId  String?
  active      Boolean   @default(true)
  archivedAt  DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  playbook Playbook? @relation(fields: [playbookId], references: [id], onDelete: SetNull)
  jobs     Job[]
  invoices Invoice[]

  @@unique([companyId, key])
  @@index([companyId, active, sortOrder])
  @@index([companyId, playbookId])
}

// ============================================================
// CRM
// ============================================================

model Customer {
  id                     String                 @id @default(cuid())
  companyId              String
  firstName              String
  lastName               String
  businessName           String?
  email                  String?
  phone                  String?
  secondaryPhone         String?
  preferredContactMethod PreferredContactMethod @default(ANY)
  notes                  String?
  status                 CustomerStatus         @default(ACTIVE)
  tags                   String[]               @default([])
  source                 String?
  sourceSystem           String?
  externalId             String?
  importSessionId        String?
  importMode             String                 @default("LIVE")
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  properties Property[]
  jobs       Job[]
  estimates  Estimate[]
  invoices   Invoice[]
  expenses   Expense[]
  equipment  Equipment[]
  leads      Lead[]
  reviews    Review[]
  reviewRequests ReviewRequest[]
  callRecords CallRecord[]
  formSubmissions FormSubmission[]
  attributionEvents AttributionEvent[]
  communicationThreads CommunicationThread[]
  importSession ImportSession? @relation(fields: [importSessionId], references: [id], onDelete: SetNull)
  customerMemberships CustomerMembership[]
  compensationEvents CompensationEvent[]
  customerNotes CustomerNote[]

  @@index([companyId])
  @@index([companyId, lastName, firstName])
  @@index([companyId, status])
  @@index([companyId, email])
  @@index([companyId, phone])
  @@index([companyId, sourceSystem, externalId])
  @@index([companyId, importSessionId])
}

model Property {
  id           String       @id @default(cuid())
  companyId    String
  customerId   String
  name         String?
  address      String
  city         String
  state        String
  zip          String
  propertyType PropertyType @default(RESIDENTIAL)
  accessNotes  String?
  gateCodeNotes String? // treat as sensitive operational note
  isPrimary    Boolean      @default(false)
  yearBuilt    Int?
  squareFeet   Int?
  bedrooms     Int?
  bathrooms    Float?
  lotSizeSqFt  Int?
  lastSaleDate DateTime?
  lastSalePriceCents Int?
  assessedValueCents Int?
  latitude     Float?
  longitude    Float?
  photoPath    String?
  photoSource  String?
  photoCaption String?
  propertyClass String?
  tags         String[]     @default([])
  enrichmentProvider     String?
  enrichmentRetrievedAt  DateTime?
  enrichmentExternalId   String?
  enrichmentStatus       String?   @default("NONE")
  factProvenance         Json?
  sourceSystem    String?
  externalId      String?
  importSessionId String?
  importMode      String       @default("LIVE")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobs      Job[]
  estimates Estimate[]
  invoices  Invoice[]
  equipment Equipment[]
  leads     Lead[]
  importSession ImportSession? @relation(fields: [importSessionId], references: [id], onDelete: SetNull)
  customerMemberships CustomerMembership[]
  customerNotes CustomerNote[]

  @@index([companyId])
  @@index([companyId, customerId])
  @@index([customerId])
  @@index([companyId, importSessionId])
  @@index([companyId, sourceSystem, externalId])
  @@index([companyId, zip])
}

model Equipment {
  id          String   @id @default(cuid())
  companyId   String
  customerId  String?
  propertyId  String?
  name        String
  equipmentType String?
  manufacturer String?
  model       String?
  serialNumber String?
  installDate DateTime?
  location    String?
  warrantyExpiresAt DateTime?
  warrantyNotes String?
  notes       String?
  sourceSystem String?
  externalId   String?
  importSessionId String?
  importMode  String   @default("LIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  importSession ImportSession? @relation(fields: [importSessionId], references: [id], onDelete: SetNull)
  photos JobPhoto[]

  @@index([companyId])
  @@index([companyId, customerId])
  @@index([companyId, propertyId])
  @@index([companyId, sourceSystem, externalId])
  @@index([companyId, importSessionId])
  @@index([companyId, serialNumber])
  @@index([companyId, model])
}

model JobPhoto {
  id            String   @id @default(cuid())
  companyId     String
  jobId         String
  equipmentId   String?
  kind          String   @default("OTHER")
  caption       String?
  fileName      String
  filePath      String
  mimeType      String
  uploadedById  String?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job        Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  equipment  Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  uploadedBy User?      @relation("JobPhotoUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([companyId, jobId])
  @@index([companyId, kind, createdAt])
}

model CustomerNote {
  id         String   @id @default(cuid())
  companyId  String
  customerId String
  propertyId String?
  jobId      String?
  authorId   String?
  body       String   @db.Text
  createdAt  DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  author   User?    @relation("CustomerNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([companyId, customerId, createdAt])
  @@index([companyId, propertyId])
}

// ============================================================
// JOBS
// ============================================================

model Job {
  id                  String      @id @default(cuid())
  companyId           String
  customerId          String
  propertyId          String
  jobNumber           String
  jobType             String?
  serviceTypeId       String?
  trade               Industry?
  status              JobStatus   @default(NEW)
  priority            JobPriority @default(NORMAL)
  source              String?
  description         String?
  internalNotes       String?
  customerNotes       String?
  scheduledStart      DateTime?
  scheduledEnd        DateTime?
  arrivalWindowStart  DateTime?
  arrivalWindowEnd    DateTime?
  completedAt         DateTime?
  // Financial readiness (cents) — populated as invoices/expenses link
  // Do not invent values; calculated from related records when available
  estimateId          String?     @unique
  playbookId          String?
  playbookVersionId   String?
  sourceSystem        String?
  externalId          String?
  importSessionId     String?
  importMode          String      @default("LIVE")
  importedTechnicianName String?
  importedSnapshot    Json?
  importedOccurredAt  DateTime?
  importedTotalCents  Int?
  scheduleLocked      Boolean     @default(false)
  routeOrder          Int?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceType ServiceType?   @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)
  playbook   Playbook?       @relation(fields: [playbookId], references: [id], onDelete: SetNull)
  playbookVersion PlaybookVersion? @relation(fields: [playbookVersionId], references: [id], onDelete: SetNull)
  playbookSnapshot JobPlaybookSnapshot?
  workflowEvents JobWorkflowEvent[]
  checklistItems JobChecklistItem[]
  customer   Customer        @relation(fields: [customerId], references: [id])
  property   Property        @relation(fields: [propertyId], references: [id])
  estimate   Estimate?       @relation("JobEstimate", fields: [estimateId], references: [id])
  estimates  Estimate[]      @relation("EstimateOptionalJob")
  invoices   Invoice[]
  expenses   Expense[]
  jobCosts   JobCost[]
  receipts   Receipt[]
  assignments JobAssignment[]
  leads      Lead[]
  reviews    Review[]
  reviewRequests ReviewRequest[]
  callRecords CallRecord[]
  attributionEvents AttributionEvent[]
  importSession ImportSession? @relation(fields: [importSessionId], references: [id], onDelete: SetNull)
  customerMemberships CustomerMembership[]
  compensationEvents CompensationEvent[]
  photos JobPhoto[]

  @@unique([companyId, jobNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, scheduledStart])
  @@index([companyId, customerId])
  @@index([companyId, propertyId])
  @@index([companyId, playbookId])
  @@index([companyId, serviceTypeId])
  @@index([companyId, sourceSystem, externalId])
  @@index([companyId, importSessionId])
  @@index([companyId, scheduleLocked])
}

model RouteOptimizationRun {
  id                 String   @id @default(cuid())
  companyId          String
  technicianUserId   String
  day                DateTime
  actorId            String
  provider           String
  status             String
  currentSeconds     Int?
  suggestedSeconds   Int?
  currentMeters      Int?
  suggestedMeters    Int?
  currentJobIds      String
  suggestedJobIds    String
  error              String?
  appliedAt          DateTime?
  createdAt          DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, technicianUserId, day])
  @@index([companyId, createdAt])
}

model JobAssignment {
  id         String   @id @default(cuid())
  jobId      String
  userId     String
  assignedAt DateTime @default(now())

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
  @@index([jobId])
}

// ============================================================
// ESTIMATES
// ============================================================

model Estimate {
  id             String         @id @default(cuid())
  companyId      String
  customerId     String
  propertyId     String?
  jobId          String?
  estimateNumber String
  status         EstimateStatus @default(DRAFT)
  issueDate      DateTime       @default(now())
  expirationDate DateTime?
  // Money in integer cents
  subtotalCents  Int            @default(0)
  taxCents       Int            @default(0)
  totalCents     Int            @default(0)
  notes          String?
  followUpAt     DateTime?
  approvedAt     DateTime?
  declinedAt     DateTime?
  sourceSystem   String?
  externalId     String?
  importSessionId String?
  importMode     String         @default("LIVE")
  publicToken    String?        @unique
  createdById    String?
  approvedOptionId String?
  approvalMethod String?
  version        Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer        @relation(fields: [customerId], references: [id])
  property  Property?       @relation(fields: [propertyId], references: [id])
  job       Job?            @relation("EstimateOptionalJob", fields: [jobId], references: [id])
  linkedJob Job?            @relation("JobEstimate")
  createdBy User?           @relation("EstimateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lineItems EstimateLineItem[]
  options   EstimateOption[]
  customerMemberships CustomerMembership[]
  leads     Lead[]
  attributionEvents AttributionEvent[]
  importSession ImportSession? @relation(fields: [importSessionId], references: [id], onDelete: SetNull)

  @@unique([companyId, estimateNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, followUpAt])
  @@index([companyId, sourceSystem, externalId])
  @@index([companyId, importSessionId])
}

model EstimateLineItem {
  id          String  @id @default(cuid())
  estimateId  String
  optionId    String?
  pricebookItemId String?
  name        String
  description String?
  quantity    Decimal @db.Decimal(12, 3)
  unitPriceCents Int
  costCents   Int?
  taxable     Boolean @default(true)
  category    String?
  sortOrder   Int     @default(0)

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  option   EstimateOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  pricebookItem PricebookItem? @relation(fields: [pricebookItemId], references: [id], onDelete: SetNull)

  @@index([estimateId])
  @@index([optionId])
}

// ============================================================
// INVOICES
// ============================================================

model Invoice {
  id             String        @id @default(cuid())
  companyId      String
  customerId     String
  propertyId     String?
  jobId          String?
  invoiceNumber  String
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @default(now())
  dueDate        DateTime?
  subtotalCents  Int           @default(0)
  taxCents       Int           @default(0)
  totalCents     Int           @default(0)
  amountPaidCents Int          @default(0)
  balanceCents   Int           @default(0)
  notes          String?
  serviceTypeId  String?
  sourceSystem   String?
  externalId     String?
  importSessionId String?
  importMode     String        @default("LIVE")
  publicToken    String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceType ServiceType?    @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)
  customer  Customer          @relation(fields: [customerId], references: [id])
  property  Property?         @relation(fields: [propertyId], references: [id])
  job       Job?              @relation(fields: [jobId], references: [id])
  lineItems InvoiceLineItem[]
  payments  Payment[]
  customerMemberships CustomerMembership[]
  attributionEvents AttributionEvent[]
  importSession ImportSession? @relation(fields: [importSessionId], references: [id], onDelete: SetNull)

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, serviceTypeId])
  @@index([companyId, dueDate])
  @@index([companyId, sourceSystem, externalId])
  @@index([companyId, importSessionId])
}

model InvoiceLineItem {
  id             String  @id @default(cuid())
  invoiceId      String
  name           String
  description    String?
  quantity       Decimal @db.Decimal(12, 3)
  unitPriceCents Int
  taxable        Boolean @default(true)
  category       String?
  sortOrder      Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// Payment records — gateway-agnostic; Stripe etc. can plug in later via externalRef
model Payment {
  id             String         @id @default(cuid())
  companyId      String
  invoiceId      String
  customerId     String?
  jobId          String?
  amountCents    Int
  method         PaymentMethod  @default(OTHER)
  status         String         @default("RECORDED") // RECORDED | PENDING | PROCESSING | SUCCEEDED | FAILED | REFUNDED | PARTIALLY_REFUNDED | CONFIRMED
  provider       String         @default("MANUAL")
  providerPaymentId String?
  recordedById   String?
  reference      String?
  paidAt         DateTime       @default(now())
  externalRef    String?
  notes          String?
  sourceSystem   String?
  externalId     String?
  importSessionId String?
  importMode     String         @default("LIVE")
  refundedCents  Int            @default(0)
  stripeAccountId String?
  currency       String         @default("usd")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy User? @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  importSession ImportSession? @relation(fields: [importSessionId], references: [id], onDelete: SetNull)

  @@unique([companyId, provider, providerPaymentId])
  @@index([companyId])
  @@index([invoiceId])
  @@index([companyId, sourceSystem, externalId])
  @@index([companyId, importSessionId])
  @@index([companyId, status])
}

model StripeConnectAccount {
  id                 String   @id @default(cuid())
  companyId          String   @unique
  stripeAccountId    String   @unique
  onboardingStatus   String   @default("ONBOARDING")
  chargesEnabled     Boolean  @default(false)
  payoutsEnabled     Boolean  @default(false)
  detailsSubmitted   Boolean  @default(false)
  requirementsDue    String?
  payoutSchedule     String?
  bankLast4          String?
  bankName           String?
  disabledAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([onboardingStatus])
}

model StripeWebhookEvent {
  id          String   @id
  companyId   String?
  eventType   String
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([companyId])
}

// ============================================================
// EXPENSES / RECEIPTS
// ============================================================

model Expense {
  id              String          @id @default(cuid())
  companyId       String
  vendor          String?
  date            DateTime        @default(now())
  amountCents     Int
  taxCents        Int             @default(0)
  category        ExpenseCategory @default(OTHER)
  description     String?
  paymentMethod   PaymentMethod?
  jobId           String?
  customerId      String?
  status          ExpenseStatus   @default(DRAFT)
  createdById     String
  receiptId       String?         @unique
  sourceSystem    String?
  externalId      String?
  importSessionId String?
  importMode      String          @default("LIVE")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy User     @relation("ExpenseCreator", fields: [createdById], references: [id])
  receipt   Receipt? @relation(fields: [receiptId], references: [id])
  jobCosts  JobCost[]
  importSession ImportSession? @relation(fields: [importSessionId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, category])
  @@index([companyId, date])
  @@index([companyId, jobId])
  @@index([companyId, status])
  @@index([companyId, sourceSystem, externalId])
  @@index([companyId, importSessionId])
}

model Receipt {
  id                  String                  @id @default(cuid())
  companyId           String
  uploadedById        String?
  fileName            String
  filePath            String
  mimeType            String
  fileSizeBytes       Int
  fileHash            String?
  processingStatus    ReceiptProcessingStatus @default(UPLOADED)
  assignment          ReceiptAssignment       @default(UNASSIGNED)
  duplicateStatus     ReceiptDuplicateStatus  @default(NONE)
  duplicateOfId       String?
  vendor              String?
  receiptDate         DateTime?
  subtotalCents       Int?
  tipCents            Int?
  totalCents          Int?
  category            ExpenseCategory?
  description         String?
  paymentMethod       PaymentMethod?
  lastFour            String?
  notes               String?
  confidence          Int?
  jobId               String?
  vehicleId           String?
  extractedMerchant   String?
  extractedDate       DateTime?
  extractedTotalCents Int?
  extractedTaxCents   Int?
  suggestedCategory   ExpenseCategory?
  suggestedJobId      String?
  extractionError     String?
  confirmedAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation("ReceiptUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  job        Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  vehicle    Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  expense    Expense?
  jobCosts   JobCost[]
  duplicateOf Receipt?  @relation("ReceiptDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates  Receipt[] @relation("ReceiptDuplicate")

  @@index([companyId])
  @@index([companyId, processingStatus])
  @@index([companyId, assignment])
  @@index([companyId, fileHash])
  @@index([companyId, jobId])
  @@index([companyId, vehicleId])
}

model Vehicle {
  id         String   @id @default(cuid())
  companyId  String
  name       String
  unitNumber String?
  year       Int?
  make       String?
  model      String?
  vin        String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  receipts Receipt[]
  assignedMemberships Membership[]

  @@index([companyId])
  @@index([companyId, active])
}

model JobCost {
  id           String         @id @default(cuid())
  companyId    String
  jobId        String
  category     JobCostCategory
  description  String?
  amountCents  Int
  sourceType   JobCostSource
  sourceId     String?
  receiptId    String?
  expenseId    String?
  createdById  String
  confirmed    Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  receipt   Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdBy User     @relation("JobCostCreator", fields: [createdById], references: [id])

  @@unique([companyId, expenseId])
  @@index([companyId, jobId])
  @@index([companyId, confirmed])
}

model QuickBooksSettings {
  id                  String                   @id @default(cuid())
  companyId           String                   @unique
  invoiceSyncTrigger  QuickBooksInvoiceTrigger @default(MANUAL_ONLY)
  appClientId         String?
  appSecretCipher     Bytes?
  appSecretIv         Bytes?
  appSecretAuthTag    Bytes?
  appSecretKeyVersion Int?
  appEnvironment      String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model QuickBooksMapping {
  id            String               @id @default(cuid())
  companyId     String
  entityType    String
  internalId    String
  quickbooksId  String
  lastSyncedAt  DateTime?
  status        QuickBooksSyncStatus @default(SYNCED)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, entityType, internalId])
  @@index([companyId, entityType, quickbooksId])
}

model QuickBooksSyncEvent {
  id            String               @id @default(cuid())
  companyId     String
  entityType    String
  internalId    String?
  quickbooksId  String?
  direction     String               @default("PUSH")
  status        QuickBooksSyncStatus
  action        String
  errorMessage  String?
  createdAt     DateTime             @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([companyId, entityType, internalId])
}

// ============================================================
// AUDIT
// ============================================================

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  actor   User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
  @@index([actorId])
  @@index([action])
}

// ============================================================
// MARKETING / INTEGRATIONS / INTELLIGENCE
// Tenant-scoped. Provider tokens live only in IntegrationCredential.
// ============================================================

model IntegrationConnection {
  id                String            @id @default(cuid())
  companyId         String
  providerKey       String
  status            IntegrationStatus @default(NOT_CONNECTED)
  accountLabel      String?
  externalAccountId String?
  scopes            String[]          @default([])
  lastSyncAt        DateTime?
  lastAttemptAt     DateTime?
  nextSyncAt        DateTime?
  lastHealthAt      DateTime?
  healthMessage     String?
  errorMessage      String?
  disabledAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  company     Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  credentials IntegrationCredential?
  syncs       IntegrationSync[]
  events      IntegrationEvent[]
  accounts    IntegrationAccount[]

  @@unique([companyId, providerKey])
  @@index([companyId])
  @@index([companyId, status])
}

model IntegrationCredential {
  id             String   @id @default(cuid())
  companyId      String
  connectionId   String   @unique
  ciphertext     Bytes
  iv             Bytes
  authTag        Bytes
  keyVersion     Int      @default(1)
  tokenExpiresAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model IntegrationSync {
  id           String    @id @default(cuid())
  companyId    String
  connectionId String
  kind         String
  status       String    @default("PENDING")
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  recordsIn    Int       @default(0)
  recordsOut   Int       @default(0)
  errorMessage String?
  summary      Json?

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([companyId, connectionId])
}

model IntegrationEvent {
  id           String    @id @default(cuid())
  companyId    String
  connectionId String
  externalId   String?
  eventType    String
  payload      Json?
  receivedAt   DateTime  @default(now())
  processedAt  DateTime?

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([companyId, connectionId])
  @@index([companyId, eventType])
  @@unique([companyId, connectionId, externalId])
}

model IntegrationAccount {
  id           String   @id @default(cuid())
  companyId    String
  connectionId String
  providerKey  String
  kind         String
  externalId   String
  name         String
  selected     Boolean  @default(false)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, kind, externalId])
  @@index([companyId, connectionId])
}

model OAuthState {
  id           String   @id @default(cuid())
  companyId    String
  userId       String
  providerKey  String
  state        String   @unique
  codeVerifier String?
  redirectTo   String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([expiresAt])
}

model WebsiteForm {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  slug        String
  fields      Json
  status      String   @default("ACTIVE")
  honeypot    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  submissions FormSubmission[]
  landingPages LandingPage[]

  @@unique([companyId, slug])
  @@index([companyId])
}

model LandingPage {
  id          String   @id @default(cuid())
  companyId   String
  formId      String?
  name        String
  slug        String
  headline    String
  body        String
  ctaLabel    String   @default("Request service")
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  form    WebsiteForm? @relation(fields: [formId], references: [id], onDelete: SetNull)

  @@unique([companyId, slug])
  @@index([companyId])
}

model TrackingNumber {
  id          String   @id @default(cuid())
  companyId   String
  phoneNumber String
  source      String
  campaign    String?
  channel     String?
  provider    String?
  status      String   @default("INACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, phoneNumber])
  @@index([companyId])
}

model Lead {
  id                           String     @id @default(cuid())
  companyId                    String
  customerId                   String?
  propertyId                   String?
  source                       LeadSource @default(MANUAL)
  sourceDetail                 String?
  provider                     String?
  externalLeadId               String?
  campaignId                   String?
  campaignName                 String?
  medium                       String?
  firstTouch                   String?
  lastTouch                    String?
  firstName                    String
  lastName                     String
  phone                        String?
  email                        String?
  message                      String?
  receivedAt                   DateTime   @default(now())
  status                       LeadStatus @default(NEW)
  assignedUserId               String?
  bookingStatus                String?
  estimateId                   String?
  jobId                        String?
  convertedAt                  DateTime?
  lostReason                   String?
  attributedRevenueCents       Int?
  attributedGrossProfitCents   Int?
  firstRespondedAt             DateTime?
  lastContactAt                DateTime?
  nextActionAt                 DateTime?
  nextAction                   String?
  estimatedOpportunityCents    Int?
  utmSource                    String?
  utmMedium                    String?
  utmCampaign                  String?
  utmContent                   String?
  utmTerm                      String?
  landingPage                  String?
  referrer                     String?
  submissionPage               String?
  visitorId                    String?
  createdAt                    DateTime   @default(now())
  updatedAt                    DateTime   @updatedAt

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  property   Property?          @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assignedUser User?            @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  estimate   Estimate?          @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  job        Job?               @relation(fields: [jobId], references: [id], onDelete: SetNull)
  campaign   Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  activities LeadActivity[]
  attributionEvents AttributionEvent[]
  callRecords CallRecord[]
  formSubmissions FormSubmission[]
  communicationThreads CommunicationThread[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, source])
  @@index([companyId, receivedAt])
  @@index([companyId, assignedUserId])
  @@index([companyId, email])
  @@index([companyId, phone])
  @@unique([companyId, provider, externalLeadId])
