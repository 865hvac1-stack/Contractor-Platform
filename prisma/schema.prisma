model LeadActivity {
  id        String   @id @default(cuid())
  companyId String
  leadId    String
  actorId   String?
  kind      String
  body      String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, leadId])
}

model AttributionEvent {
  id              String           @id @default(cuid())
  companyId       String
  leadId          String?
  customerId      String?
  jobId           String?
  invoiceId       String?
  estimateId      String?
  model           AttributionModel @default(PRIMARY_SOURCE)
  source          String
  campaignId      String?
  revenueCents    Int?
  costCents       Int?
  note            String?
  overriddenById  String?
  createdAt       DateTime         @default(now())

  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  job          Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  invoice      Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  estimate     Estimate? @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  overriddenBy User?     @relation("AttributionOverride", fields: [overriddenById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, source])
  @@index([companyId, leadId])
}

model MarketingSpend {
  id            String   @id @default(cuid())
  companyId     String
  source        String
  campaignName  String?
  provider      String?
  periodStart   DateTime
  periodEnd     DateTime
  amountCents   Int
  externalId    String?
  createdAt     DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, periodStart, periodEnd])
  @@index([companyId, source])
  @@unique([companyId, provider, externalId])
}

model Campaign {
  id          String         @id @default(cuid())
  companyId   String
  name        String
  type        CampaignType
  status      CampaignStatus @default(DRAFT)
  channel     String?
  scheduledAt DateTime?
  sentAt      DateTime?
