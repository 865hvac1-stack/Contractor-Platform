model Membership {
  id          String           @id @default(cuid())
  companyId   String
  userId      String
  role        CompanyRole
  status      MembershipStatus @default(ACTIVE)
  invitedById String?
  invitedAt   DateTime?
  joinedAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company                  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy                User?    @relation("MembershipInviter", fields: [invitedById], references: [id])
  assignedVehicleId        String?
  assignedVehicle          Vehicle? @relation(fields: [assignedVehicleId], references: [id], onDelete: SetNull)
  routeStartKind           String?
  routeEndKind             String?
  homeAddress              String?
  homeCity                 String?
  homeState                String?
  homeZip                  String?
  customerPhotoPath        String?
  customerDisplayName      String?
  customerBio              String?
  yearsExperience          Int?
  certifications           String[] @default([])
  customerIntroduction     String?
  internalJobCostRateCents Int?

  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId, role])
  @@index([companyId, status])
}

model NumberSequence {
  id        String @id @default(cuid())
  companyId String
  kind      String // JOB | ESTIMATE | INVOICE
  prefix    String
  nextValue Int    @default(1)
  padding   Int    @default(5)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, kind])
}

/// Company-scoped “what kind of work” catalog. Distinct from Pricebook items.
model ServiceType {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  key         String
  description String?
  playbookKey String?
  playbookId  String?
  active      Boolean   @default(true)
  archivedAt  DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company                 Company                        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  playbook                Playbook?                      @relation(fields: [playbookId], references: [id], onDelete: SetNull)
  jobs                    Job[]
  invoices                Invoice[]
  schedulingRules         ServiceTypeSchedulingRule[]
  technicianEligibilities TechnicianServiceEligibility[]
  technicianCategoryMappings TechnicianJobCategoryMapping[]
  defaultForPolicies      SchedulingPolicy[]             @relation("DefaultServiceType")
  maintenanceForPolicies  SchedulingPolicy[]             @relation("MaintenanceServiceType")

  @@unique([companyId, key])
  @@index([companyId, active, sortOrder])
  @@index([companyId, playbookId])
}

// ============================================================
// CRM
// ============================================================

model Customer {
  id                            String                 @id @default(cuid())
  companyId                     String
  firstName                     String
  lastName                      String
  businessName                  String?
  email                         String?
  phone                         String?
  secondaryPhone                String?
  preferredContactMethod        PreferredContactMethod @default(ANY)
  notes                         String?
  status                        CustomerStatus         @default(ACTIVE)
  tags                          String[]               @default([])
  source                        String?
  sourceSystem                  String?
  externalId                    String?
  importSessionId               String?
  importMode                    String                 @default("LIVE")
  quickbooksCustomerId          String?
  quickbooksRealmId             String?
  quickbooksLastModifiedAt      DateTime?
  lastSyncedAt                  DateTime?
  syncStatus                    String?
  syncError                     String?
  smsMarketingOptedOutAt        DateTime?
  smsOptOutSource               String?
  communicationConsentUpdatedAt DateTime?
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt

  company                      Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  properties                   Property[]
  jobs                         Job[]
  estimates                    Estimate[]
  invoices                     Invoice[]
  expenses                     Expense[]
  equipment                    Equipment[]
  leads                        Lead[]
  reviews                      Review[]
  reviewRequests               ReviewRequest[]
  callRecords                  CallRecord[]
  formSubmissions              FormSubmission[]
  attributionEvents            AttributionEvent[]
  communicationThreads         CommunicationThread[]
  importSession                ImportSession?                @relation(fields: [importSessionId], references: [id], onDelete: SetNull)
  customerMemberships          CustomerMembership[]
  compensationEvents           CompensationEvent[]
  customerNotes                CustomerNote[]
  waitingRecords               WaitingRecord[]
  conversationSchedulingStates ConversationSchedulingState[]
  maintenanceVisits            MaintenanceVisit[]
  automationExecutions         AutomationExecution[]
  conversationGoalSessions     ConversationGoalSession[]
  customerRequests             CustomerRequest[]
  projects                     Project[]                     @relation("ProjectCustomer")

  @@index([companyId])
  @@index([companyId, lastName, firstName])
  @@index([companyId, status])
  @@index([companyId, email])
  @@index([companyId, phone])
  @@index([companyId, sourceSystem, externalId])
  @@index([companyId, importSessionId])
  @@index([companyId, quickbooksCustomerId])
  @@index([companyId, quickbooksRealmId])
}

model Property {
  id                    String       @id @default(cuid())
  companyId             String
  customerId            String
  name                  String?
  address               String
  city                  String
  state                 String
  zip                   String
  propertyType          PropertyType @default(RESIDENTIAL)
  accessNotes           String?
  gateCodeNotes         String? // treat as sensitive operational note
  isPrimary             Boolean      @default(false)
  yearBuilt             Int?
  squareFeet            Int?
  bedrooms              Int?
  bathrooms             Float?
  lotSizeSqFt           Int?
  lastSaleDate          DateTime?
  lastSalePriceCents    Int?
  assessedValueCents    Int?
  latitude              Float?
  longitude             Float?
  geocodingStatus       String?      @default("NONE")
  geocodedAt            DateTime?
  geocodingProvider     String?
  geocodedFormattedAddress String?
  geocodingConfidence   String?
  geocodePlaceId        String?
  lastGeocodeAttemptAt  DateTime?
  geocodeError          String?
  photoPath             String?
  photoSource           String?
  photoCaption          String?
  propertyClass         String?
  tags                  String[]     @default([])
  enrichmentProvider    String?
  enrichmentRetrievedAt DateTime?
  enrichmentExternalId  String?
  enrichmentStatus      String?      @default("NONE")
  factProvenance        Json?
  sourceSystem          String?
  externalId            String?
  importSessionId       String?
  importMode            String       @default("LIVE")
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

