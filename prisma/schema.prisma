  importSession           ImportSession?           @relation(fields: [importSessionId], references: [id], onDelete: SetNull)
  project                 Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectBillingMilestone ProjectBillingMilestone?

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, serviceTypeId])
  @@index([companyId, dueDate])
  @@index([companyId, sourceSystem, externalId])
  @@index([companyId, importSessionId])
  @@index([companyId, deliveryStatus])
  @@index([companyId, quickbooksInvoiceId])
  @@index([companyId, projectId])
}

model InvoiceLineItem {
  id               String  @id @default(cuid())
