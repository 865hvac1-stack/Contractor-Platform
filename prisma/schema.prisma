// ============================================================
// PLATFORM / AUTH
// ============================================================

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  firstName            String
  lastName             String
  phone                String?
  isPlatformAdmin      Boolean   @default(false)
  loadedLaborCostCents Int?
  emailVerifiedAt      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  memberships                     Membership[]
  sessions                        Session[]
  passwordResetTokens             PasswordResetToken[]
  teamInvitesSent                 TeamInvite[]                     @relation("TeamInviteSender")
  auditLogs                       AuditLog[]                       @relation("AuditActor")
  assignedJobs                    JobAssignment[]
  expensesCreated                 Expense[]                        @relation("ExpenseCreator")
  invitedMemberships              Membership[]                     @relation("MembershipInviter")
  assignedLeads                   Lead[]                           @relation("LeadAssignee")
  leadActivities                  LeadActivity[]
  attributionOverrides            AttributionEvent[]               @relation("AttributionOverride")
  playbookVersionsCreated         PlaybookVersion[]                @relation("PlaybookVersionAuthor")
  jobWorkflowEvents               JobWorkflowEvent[]
  oauthStates                     OAuthState[]
  importSessions                  ImportSession[]
  importResetOperations           ImportResetOperation[]           @relation("ImportResetActor")
  receiptsUploaded                Receipt[]                        @relation("ReceiptUploader")
  jobCostsCreated                 JobCost[]                        @relation("JobCostCreator")
  jobPartsCreated                 JobPart[]                        @relation("JobPartCreator")
  inventoryMovements              InventoryMovement[]              @relation("InventoryMovementActor")
  estimatesCreated                Estimate[]                       @relation("EstimateCreator")
  paymentsRecorded                Payment[]                        @relation("PaymentRecorder")
  membershipsSold                 CustomerMembership[]             @relation("MembershipSoldBy")
  compensationEvents              CompensationEvent[]
  compensationApprovals           CompensationEvent[]              @relation("CompensationApprover")
  jobPhotosUploaded               JobPhoto[]                       @relation("JobPhotoUploader")
  customerNotesAuthored           CustomerNote[]                   @relation("CustomerNoteAuthor")
  waitingRecordsOwned             WaitingRecord[]                  @relation("WaitingRecordOwner")
  waitingTransitions              WaitingTransition[]
  performanceGoals                PerformanceGoal[]
  aiConversations                 AIConversation[]
  aiUsageEvents                   AIUsageEvent[]
  aiActionDrafts                  AIActionDraft[]
  aiActionsRequested              AIActionRequest[]                @relation("AIActionRequestedBy")
  aiActionsApproved               AIActionRequest[]                @relation("AIActionApprovedBy")
  companyTasksAssigned            CompanyTask[]                    @relation("CompanyTaskAssignee")
  companyTasksCreated             CompanyTask[]                    @relation("CompanyTaskCreator")
  technicianWindowAvailabilities  TechnicianWindowAvailability[]
  availabilityOverrides           AvailabilityOverride[]
  technicianServiceEligibilities  TechnicianServiceEligibility[]
  schedulingBookings              SchedulingBooking[]
  projectLaborEntriesWorked       ProjectLaborEntry[]              @relation("ProjectLaborEmployee")
  projectLaborEntriesCreated      ProjectLaborEntry[]              @relation("ProjectLaborCreator")
  projectLaborEntriesEdited       ProjectLaborEntry[]              @relation("ProjectLaborEditor")
  projectLaborRevisions           ProjectLaborRevision[]           @relation("ProjectLaborRevisionActor")
  technicianIntelligenceProfiles  TechnicianIntelligenceProfile[]  @relation("TechnicianIntelligenceSubject")
  technicianEvaluationsCompleted  TechnicianIntelligenceProfile[]  @relation("TechnicianIntelligenceEvaluator")
  technicianQualificationsCreated TechnicianQualification[]        @relation("TechnicianQualificationCreator")
  technicianPreferencesChanged    TechnicianCallPreference[]       @relation("TechnicianPreferenceActor")
  technicianIntelligenceOverrides TechnicianIntelligenceOverride[] @relation("TechnicianIntelligenceOverrideActor")
  technicianSkillRatingsUpdated    TechnicianSkillRating[]           @relation("TechnicianSkillRatingUpdater")
  technicianJobRelationshipsCreated TechnicianJobRelationship[]      @relation("TechnicianJobRelationshipCreator")
  technicianLocations               TechnicianLocation[]

  @@index([email])
  @@index([isPlatformAdmin])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TeamInvite {
  id              String      @id @default(cuid())
  companyId       String
  email           String
  firstName       String
  lastName        String
  role            CompanyRole
  tokenHash       String      @unique
  invitedById     String
  userId          String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  lastEmailStatus String?
  lastEmailError  String?
  lastEmailedAt   DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("TeamInviteSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([companyId, email])
  @@index([companyId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

