enum BillingWatchdogSeverity {
  CRITICAL
  ACTION_NEEDED
  WATCH
}

enum BillingWatchdogFindingStatus {
  OPEN
  RESOLVED
  EXCLUDED
}

model BillingWatchdogSettings {
  companyId                  String   @id
  startDate                  DateTime @db.Date
  checkoutGraceMinutes       Int      @default(120)
  completedInvoiceGraceHours Int      @default(8)
  invoiceSendGraceHours      Int      @default(4)
  accountingSyncGraceHours   Int      @default(24)
  morningSummaryEnabled      Boolean  @default(false)
  morningSummaryRoles        Json?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model BillingWatchdogFinding {
  id                String                       @id @default(cuid())
  companyId         String
  type              String
  severity          BillingWatchdogSeverity
  status            BillingWatchdogFindingStatus @default(OPEN)
  fingerprint       String
  jobId             String?
  invoiceId         String?
  paymentId         String?
  customerId        String?
  technicianId      String?
  amountAtRiskCents Int?
  amountUnknown     Boolean                      @default(false)
  reason            String                       @db.Text
  recommendedAction String
  metadata          Json?
  detectedAt        DateTime
  firstDetectedAt   DateTime
  lastDetectedAt    DateTime
  resolvedAt        DateTime?
  excludedAt        DateTime?
  excludedById      String?
  exclusionCode     String?
  exclusionReason   String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job     Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([companyId, fingerprint])
  @@index([companyId, status, type])
  @@index([companyId, lastDetectedAt])
  @@index([companyId, jobId])
  @@index([companyId, invoiceId])
}

