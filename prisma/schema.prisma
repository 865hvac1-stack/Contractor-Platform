  name             String
  description      String?
  quantity         Decimal @db.Decimal(12, 3)
  unitPriceCents   Int
  taxable          Boolean @default(true)
  category         String?
  sortOrder        Int     @default(0)
  amountCents      Int?
  externalId       String?
  quickbooksItemId String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// Payment records — gateway-agnostic; Stripe etc. can plug in later via externalRef
model Payment {
  id                       String        @id @default(cuid())
  companyId                String
  invoiceId                String
  customerId               String?
  jobId                    String?
  amountCents              Int
  method                   PaymentMethod @default(OTHER)
  status                   String        @default("RECORDED") // RECORDED | PENDING | PROCESSING | SUCCEEDED | FAILED | REFUNDED | PARTIALLY_REFUNDED | CONFIRMED
  provider                 String        @default("MANUAL")
  providerPaymentId        String?
  recordedById             String?
  reference                String?
  paidAt                   DateTime      @default(now())
  externalRef              String?
  notes                    String?
  sourceSystem             String?
  externalId               String?
  importSessionId          String?
  importMode               String        @default("LIVE")
  quickbooksPaymentId      String?
  quickbooksRealmId        String?
  quickbooksLastModifiedAt DateTime?
  lastSyncedAt             DateTime?
  syncStatus               String?
  syncError                String?
  refundedCents            Int           @default(0)
  stripeAccountId          String?
  currency                 String        @default("usd")
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy    User?          @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  importSession ImportSession? @relation(fields: [importSessionId], references: [id], onDelete: SetNull)

  @@unique([companyId, provider, providerPaymentId])
  @@index([companyId])
  @@index([invoiceId])
  @@index([companyId, sourceSystem, externalId])
  @@index([companyId, importSessionId])
  @@index([companyId, status])
  @@index([companyId, quickbooksPaymentId])
}

model StripeConnectAccount {
