  rule    ReceptionistOpportunityRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([companyId, threadId, createdAt])
}

model AIConversation {
  id            String   @id @default(cuid())
  companyId     String
  userId        String
  title         String?
  scope         String   @default("COMPANY")
  jobId         String?
  lastResultSet Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       AIMessage[]
  usages         AIUsageEvent[]
  actionRequests AIActionRequest[]

  @@index([companyId, userId])
  @@index([companyId, updatedAt])
}

model AIMessage {
  id             String   @id @default(cuid())
  companyId      String
  conversationId String
  role           String
  content        String
  grounding      Json?
  createdAt      DateTime @default(now())

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([companyId, conversationId])
}

model AIUsageEvent {
  id                    String   @id @default(cuid())
  companyId             String
  userId                String?
  conversationId        String?
  feature               String
  model                 String
  inputTokens           Int      @default(0)
  outputTokens          Int      @default(0)
  estimatedCostMicrousd Int      @default(0)
  latencyMs             Int?
  status                String   @default("OK")
  errorKind             String?
  createdAt             DateTime @default(now())

  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversation AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}

model AIActionDraft {
  id         String    @id @default(cuid())
  companyId  String
  userId     String
  actionType String
  status     String    @default("DRAFT")
  payload    Json
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
}

enum AIActionLevel {
  READ
  PREPARE
  EXECUTE
}

enum AIActionRisk {
  LOW
  MEDIUM
  HIGH
}

enum AIActionRequestStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  EXECUTING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  CANCELED
  EXPIRED
}

enum AIActionTargetStatus {
  PENDING
  EXCLUDED
  EXECUTED
  SKIPPED
  FAILED
}

model AIActionRequest {
  id                   String                @id @default(cuid())
  companyId            String
  requestedByUserId    String
  conversationId       String?
  approvedByUserId     String?
  actionKey            String
  actionVersion        Int                   @default(1)
  level                AIActionLevel
  riskLevel            AIActionRisk
  status               AIActionRequestStatus @default(DRAFT)
  title                String
  summary              String                @db.Text
  input                Json
  preview              Json
  criteria             Json?
  estimatedImpactCents Int?
  targetCount          Int                   @default(0)
  executedCount        Int                   @default(0)
  skippedCount         Int                   @default(0)
  failedCount          Int                   @default(0)
  provider             String?
  executionMode        String?
  idempotencyKey       String
  failureReason        String?
  expiresAt            DateTime
  approvedAt           DateTime?
  executedAt           DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestedBy  User             @relation("AIActionRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  approvedBy   User?            @relation("AIActionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  conversation AIConversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  targets      AIActionTarget[]

  @@unique([companyId, idempotencyKey])
  @@index([companyId, status, createdAt])
  @@index([companyId, conversationId])
  @@index([companyId, actionKey])
}

model AIActionTarget {
  id               String               @id @default(cuid())
  companyId        String
  requestId        String
  recordType       String
  recordId         String
  customerId       String?
  customerName     String?
  amountCents      Int?
  daysValue        Int?
  channel          String?
  recipient        String?
  draftMessage     String?              @db.Text
  reason           String?
  payload          Json?
  status           AIActionTargetStatus @default(PENDING)
  skipReason       String?
  failureReason    String?
  provider         String?
  providerResultId String?
  executedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  request AIActionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, requestId])
  @@index([companyId, recordType, recordId])
  @@index([companyId, status])
}

model CompanyTask {
  id               String    @id @default(cuid())
  companyId        String
  assignedToUserId String?
  createdByUserId  String?
  actionRequestId  String?
  title            String
  details          String?   @db.Text
  dueAt            DateTime?
  status           String    @default("OPEN")
  relatedType      String?
  relatedId        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedTo User?   @relation("CompanyTaskAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdBy  User?   @relation("CompanyTaskCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, status, dueAt])
  @@index([companyId, assignedToUserId])
}

model MetricSnapshot {
  id          String   @id @default(cuid())
  companyId   String
  metricKey   String
  periodStart DateTime
  periodEnd   DateTime
  grain       String
  value       Float
  sampleSize  Int      @default(0)
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, metricKey, periodStart, periodEnd, grain])
  @@index([companyId, metricKey])
}

model SocialPost {
  id          String    @id @default(cuid())
  companyId   String
  channel     String
  provider    String?
  externalId  String?
  status      String    @default("DRAFT")
  body        String
  linkUrl     String?
  mediaUrl    String?
  ctaLabel    String?
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company      Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  publications SocialPostPublication[]

  @@index([companyId, status])
}

model SocialPostPublication {
  id           String    @id @default(cuid())
  companyId    String
  postId       String
  channel      String
  status       String    @default("PENDING")
  externalId   String?
  errorMessage String?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  post    SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, channel])
  @@index([companyId, postId])
}

model FormSubmission {
  id             String   @id @default(cuid())
  companyId      String
  websiteFormId  String?
  landingPageId  String?
  leadId         String?
  customerId     String?
  landingPage    String?
  referrer       String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  firstTouch     String?
  lastTouch      String?
  submissionPage String?
  visitorId      String?
  payload        Json?
  createdAt      DateTime @default(now())

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  websiteForm WebsiteForm? @relation(fields: [websiteFormId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([companyId, websiteFormId])
}

// ============================================================
// PLAYBOOKS — company-owned workflows. Jobs may have no playbook.
// Versions freeze the definition so later edits do not rewrite history.
// ============================================================

model Playbook {
  id               String         @id @default(cuid())
  companyId        String
  name             String
  description      String?
  status           PlaybookStatus @default(ACTIVE)
  sortOrder        Int            @default(0)
  currentVersionId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceTypes  ServiceType[]
  versions      PlaybookVersion[]
  jobs          Job[]
  snapshots     JobPlaybookSnapshot[]
  formTemplates FormTemplate[]
  automations   Automation[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, sortOrder])
}

model PlaybookVersion {
  id            String   @id @default(cuid())
  companyId     String
  playbookId    String
  versionNumber Int
  definition    Json
  createdById   String?
  createdAt     DateTime @default(now())

  company   Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  playbook  Playbook              @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  createdBy User?                 @relation("PlaybookVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  jobs      Job[]
  snapshots JobPlaybookSnapshot[]

  @@unique([playbookId, versionNumber])
  @@index([companyId])
}

model JobPlaybookSnapshot {
  id              String   @id @default(cuid())
  companyId       String
  jobId           String   @unique
  playbookId      String
  versionId       String
  definition      Json
  currentStageKey String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job      Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  playbook Playbook        @relation(fields: [playbookId], references: [id], onDelete: Restrict)
  version  PlaybookVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([companyId, playbookId])
}

model JobWorkflowEvent {
  id        String   @id @default(cuid())
  companyId String
  jobId     String
  stepId    String
  actorId   String?
  kind      String
  note      String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, jobId])
}

model JobChecklistItem {
  id          String    @id @default(cuid())
  companyId   String
  jobId       String
  itemId      String
  section     String?
  label       String
  required    Boolean   @default(false)
  fieldType   String    @default("CHECKBOX")
  completed   Boolean   @default(false)
  value       String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, itemId])
  @@index([companyId, jobId])
}

// Configurable forms for a later builder. Fields are JSON so new field types
// do not require a migration. Every template is company-scoped.
model FormTemplate {
  id          String   @id @default(cuid())
  companyId   String
  playbookId  String?
  name        String
  description String?
  fields      Json
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  playbook Playbook? @relation(fields: [playbookId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, playbookId])
}

enum ImportRecordType {
  CUSTOMERS
  PROPERTIES
  CONTACTS
  JOBS
  ESTIMATES
  INVOICES
  PAYMENTS
  EQUIPMENT
  MEMBERSHIPS
  NOTES
  TAGS
  LEAD_SOURCES
  EXPENSES
  PRICEBOOK
  COMMUNICATIONS
  OTHER
}

enum ImportSourceType {
  HOUSECALL_PRO
  SERVICETITAN
  JOBBER
  FIELDEDGE
  SERVICE_FUSION
  WORKIZ
  QUICKBOOKS
  HUBSPOT
  SALESFORCE
  SPREADSHEET
  OTHER
  UNKNOWN
}

enum ImportSessionStatus {
  UPLOADED
  ANALYZING
  MAPPING_REQUIRED
  READY_FOR_PREVIEW
  READY_TO_IMPORT
  IMPORTING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum ImportRowStatus {
  PENDING
  VALID
  WARNING
  ERROR
  IMPORTED
  SKIPPED
  FAILED
}

enum ImportRowAction {
  CREATE
  UPDATE
  MERGE
  SKIP
  ERROR
}

enum ImportDuplicateVerdict {
  NEW
  LIKELY_DUPLICATE
  EXACT_MATCH
  NEEDS_REVIEW
}

model MigrationProject {
  id         String           @id @default(cuid())
  companyId  String
  name       String
  sourceType ImportSourceType @default(UNKNOWN)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions   ImportSession[]

  @@index([companyId, createdAt])
}

model ImportSession {
  id                 String              @id @default(cuid())
  companyId          String
  userId             String
  recordType         ImportRecordType
  sourceType         ImportSourceType
  fileName           String
  fileHash           String
  mimeType           String?
  encoding           String?
  status             ImportSessionStatus @default(UPLOADED)
  rowCount           Int                 @default(0)
  analysis           Json?
  mapping            Json?
  previewSummary     Json?
  importSummary      Json?
  intelligence       String?
  errorMessage       String?
  duplicatePolicy    String              @default("SKIP")
  importMode         String              @default("HISTORICAL")
  detectedRecordType ImportRecordType?
  rowAccounting      Json?
  qualityScore       Json?
  migrationProjectId String?
  confirmedAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  processedRows      Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  migrationProject   MigrationProject?   @relation(fields: [migrationProjectId], references: [id], onDelete: SetNull)
  rows               ImportRow[]
  externalRefs       ImportExternalRef[]
  createdCustomers   Customer[]
  createdProperties  Property[]
  createdJobs        Job[]
  createdEstimates   Estimate[]
  createdInvoices    Invoice[]
  createdPayments    Payment[]
  createdEquipment   Equipment[]
  createdExpenses    Expense[]

  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@index([companyId, migrationProjectId])
}

model ImportRow {
  id               String                 @id @default(cuid())
  companyId        String
  importSessionId  String
  rowNumber        Int
  status           ImportRowStatus        @default(PENDING)
  action           ImportRowAction        @default(CREATE)
  duplicateVerdict ImportDuplicateVerdict @default(NEW)
  rawData          Json
  normalizedData   Json?
  mappedData       Json?
  issues           Json?
  targetRecordId   String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  company          Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  session          ImportSession          @relation(fields: [importSessionId], references: [id], onDelete: Cascade)

  @@unique([importSessionId, rowNumber])
  @@index([companyId, importSessionId])
  @@index([importSessionId, status])
  @@index([companyId, targetRecordId])
}

model ImportExternalRef {
  id              String           @id @default(cuid())
  companyId       String
  sourceSystem    ImportSourceType
  recordType      ImportRecordType
  externalId      String
  targetRecordId  String
  importSessionId String?
  createdAt       DateTime         @default(now())
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  session         ImportSession?   @relation(fields: [importSessionId], references: [id], onDelete: SetNull)

  @@unique([companyId, sourceSystem, recordType, externalId])
  @@index([companyId, recordType, targetRecordId])
}

model ImportMappingProfile {
  id                String           @id @default(cuid())
  companyId         String?
  sourceType        ImportSourceType
  recordType        ImportRecordType
  name              String
  headerFingerprint String
  mapping           Json
  isSystem          Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  company           Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([sourceType, recordType])
}

model ImportResetOperation {
  id                 String    @id @default(cuid())
  companyId          String
  initiatedById      String
  sourceSystem       String
  mode               String
  status             String
  confirmationPhrase String?
  counts             Json
  preserved          Json
  blocked            Json
  mixed              Json?
  census             Json?
  idempotentReplay   Boolean   @default(false)
  createdAt          DateTime  @default(now())
  completedAt        DateTime?

  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  initiatedBy User    @relation("ImportResetActor", fields: [initiatedById], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([companyId, sourceSystem, mode])
}

model ImportReviewItem {
  id                 String   @id @default(cuid())
  companyId          String
  sourceSystem       String
  recordType         String
  status             String   @default("OPEN")
  confidence         String
  proposedCustomerId String?
  externalId         String?
  payload            Json
  reason             String
  importSessionId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([companyId, sourceSystem, recordType])
  @@index([companyId, proposedCustomerId])
}

// ============================================================
// PRICEBOOK / ESTIMATE OPTIONS / MEMBERSHIPS / COMPENSATION
// ============================================================

model PricebookCategory {
  id        String   @id @default(cuid())
  companyId String
  parentId  String?
  name      String
  sortOrder Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   PricebookCategory?  @relation("PricebookCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children PricebookCategory[] @relation("PricebookCategoryTree")
  items    PricebookItem[]

  @@index([companyId, archived])
  @@index([companyId, parentId])
}

model PricebookItem {
  id                  String            @id @default(cuid())
  companyId           String
  categoryId          String
  name                String
  internalName        String?
  sku                 String?
  type                PricebookItemType @default(SERVICE)
  customerDescription String?
  technicianNotes     String?
  standardPriceCents  Int
  memberPriceCents    Int?
  internalCostCents   Int?
  taxable             Boolean           @default(true)
  unit                String            @default("each")
  active              Boolean           @default(true)
  sortOrder           Int               @default(0)
  importMode          String            @default("LIVE")
  sourceSystem        String?
  externalId          String?
  quickbooksItemId    String?
  quickbooksRealmId   String?
  incomeAccount       String?
  cogsAccount         String?
  taxCode             String?
  lastSyncedAt        DateTime?
  syncStatus          String?
  syncError           String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category                PricebookCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  lineItems               EstimateLineItem[]
  inventoryStocks         InventoryStock[]
  inventoryMovements      InventoryMovement[]
  jobParts                JobPart[]
  projectMaterials        ProjectMaterial[]
  projectMaterialRequests ProjectMaterialRequest[]

  @@index([companyId, active])
  @@index([companyId, categoryId])
  @@index([companyId, name])
  @@index([companyId, sku])
  @@index([companyId, sourceSystem, externalId])
  @@index([companyId, quickbooksItemId])
}

model InventoryLocation {
  id           String                @id @default(cuid())
  companyId    String
  name         String
  type         InventoryLocationType @default(WAREHOUSE)
  membershipId String?
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stocks        InventoryStock[]
  jobParts      JobPart[]
  movementsFrom InventoryMovement[] @relation("InventoryMovementFrom")
  movementsTo   InventoryMovement[] @relation("InventoryMovementTo")

  @@unique([companyId, name])
  @@index([companyId, active])
  @@index([companyId, membershipId])
}

model InventoryStock {
  id           String   @id @default(cuid())
  companyId    String
  partId       String
  locationId   String
  onHand       Int      @default(0)
  reserved     Int      @default(0)
  minimumStock Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  part     PricebookItem     @relation(fields: [partId], references: [id], onDelete: Cascade)
  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([companyId, partId, locationId])
  @@index([companyId, partId])
  @@index([companyId, locationId])
}

model JobPart {
  id             String        @id @default(cuid())
  companyId      String
  jobId          String
  partId         String
  locationId     String?
  quantity       Int
  status         JobPartStatus @default(NEEDED)
  unitCostCents  Int
  unitPriceCents Int?
  notes          String?
  createdById    String
  reservedAt     DateTime?
  pickedUpAt     DateTime?
  installedAt    DateTime?
  canceledAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job       Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  part      PricebookItem      @relation(fields: [partId], references: [id], onDelete: Restrict)
  location  InventoryLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy User               @relation("JobPartCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([companyId, jobId, status])
  @@index([companyId, partId])
  @@index([companyId, locationId])
}

model InventoryMovement {
  id             String                @id @default(cuid())
  companyId      String
  partId         String
  quantity       Int
  type           InventoryMovementType
  fromLocationId String?
  toLocationId   String?
  jobId          String?
  jobPartId      String?
  actorId        String
  notes          String?
  source         String?
  reference      String?
  createdAt      DateTime              @default(now())

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  part         PricebookItem      @relation(fields: [partId], references: [id], onDelete: Restrict)
  fromLocation InventoryLocation? @relation("InventoryMovementFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation   InventoryLocation? @relation("InventoryMovementTo", fields: [toLocationId], references: [id], onDelete: SetNull)
  job          Job?               @relation(fields: [jobId], references: [id], onDelete: SetNull)
  actor        User               @relation("InventoryMovementActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([companyId, partId, createdAt])
  @@index([companyId, fromLocationId, createdAt])
  @@index([companyId, toLocationId, createdAt])
  @@index([companyId, jobId])
  @@index([companyId, jobPartId])
}

model EstimateOption {
  id          String   @id @default(cuid())
  companyId   String
  estimateId  String
  name        String
  description String?
