  assignment          ReceiptAssignment       @default(UNASSIGNED)
  duplicateStatus     ReceiptDuplicateStatus  @default(NONE)
  duplicateOfId       String?
  vendor              String?
  receiptDate         DateTime?
  subtotalCents       Int?
  tipCents            Int?
  totalCents          Int?
  category            ExpenseCategory?
  description         String?
  paymentMethod       PaymentMethod?
  lastFour            String?
  notes               String?
  confidence          Int?
  jobId               String?
  vehicleId           String?
  extractedMerchant   String?
  extractedDate       DateTime?
  extractedTotalCents Int?
  extractedTaxCents   Int?
  suggestedCategory   ExpenseCategory?
