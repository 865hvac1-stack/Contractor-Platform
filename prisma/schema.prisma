// ============================================================
// JOBS
// ============================================================

model Job {
  id                       String      @id @default(cuid())
  companyId                String
  customerId               String
  propertyId               String
  jobNumber                String
  jobType                  String?
  serviceTypeId            String?
  trade                    Industry?
  status                   JobStatus   @default(NEW)
  priority                 JobPriority @default(NORMAL)
  source                   String?
  description              String?
  internalNotes            String?
  customerNotes            String?
  scheduledStart           DateTime?
  scheduledEnd             DateTime?
  arrivalWindowStart       DateTime?
  arrivalWindowEnd         DateTime?
  checkedInAt              DateTime?
  checkedOutAt             DateTime?
  completedAt              DateTime?
  // Financial readiness (cents) — populated as invoices/expenses link
  // Do not invent values; calculated from related records when available
  estimateId               String?     @unique
  playbookId               String?
  playbookVersionId        String?
  sourceSystem             String?
  externalId               String?
  importSessionId          String?
  importMode               String      @default("LIVE")
  importedTechnicianName   String?
  importedSnapshot         Json?
  importedOccurredAt       DateTime?
  importedTotalCents       Int?
  scheduleLocked           Boolean     @default(false)
  routeOrder               Int?
  appointmentWindowId      String?
  bookedByContractorYou    Boolean     @default(false)
  confirmationFailed       Boolean     @default(false)
  schedulingIdempotencyKey String?
  projectId                String?
  projectPhaseId           String?
  projectVisitPurpose      String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  company                            Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceType                        ServiceType?                  @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)
  playbook                           Playbook?                     @relation(fields: [playbookId], references: [id], onDelete: SetNull)
  playbookVersion                    PlaybookVersion?              @relation(fields: [playbookVersionId], references: [id], onDelete: SetNull)
  playbookSnapshot                   JobPlaybookSnapshot?
  workflowEvents                     JobWorkflowEvent[]
  checklistItems                     JobChecklistItem[]
  customer                           Customer                      @relation(fields: [customerId], references: [id])
  property                           Property                      @relation(fields: [propertyId], references: [id])
  estimate                           Estimate?                     @relation("JobEstimate", fields: [estimateId], references: [id])
  estimates                          Estimate[]                    @relation("EstimateOptionalJob")
  invoices                           Invoice[]
  expenses                           Expense[]
  jobCosts                           JobCost[]
  jobParts                           JobPart[]
  inventoryMovements                 InventoryMovement[]
  receipts                           Receipt[]
  assignments                        JobAssignment[]
  leads                              Lead[]
  reviews                            Review[]
  reviewRequests                     ReviewRequest[]
  callRecords                        CallRecord[]
  attributionEvents                  AttributionEvent[]
  importSession                      ImportSession?                @relation(fields: [importSessionId], references: [id], onDelete: SetNull)
  customerMemberships                CustomerMembership[]
  compensationEvents                 CompensationEvent[]
  photos                             JobPhoto[]
  waitingRecords                     WaitingRecord[]
  appointmentWindow                  AppointmentWindow?            @relation(fields: [appointmentWindowId], references: [id], onDelete: SetNull)
  schedulingBooking                  SchedulingBooking?
  maintenanceVisits                  MaintenanceVisit[]
  conversationSchedulingStates       ConversationSchedulingState[]
  billingWatchdogFindings            BillingWatchdogFinding[]
  customerRequests                   CustomerRequest[]
  project                            Project?                      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectPhase                       ProjectPhase?                 @relation(fields: [projectPhaseId], references: [id], onDelete: SetNull)
  projectLaborEntries                ProjectLaborEntry[]
  technicianJobRelationshipsOriginal TechnicianJobRelationship[]   @relation("TechnicianOriginalJob")
  technicianJobRelationshipsRelated  TechnicianJobRelationship[]   @relation("TechnicianRelatedJob")
  smartDispatchRecommendations       SmartDispatchRecommendation[]
  smartDispatchEvents                SmartDispatchEvent[]

  @@unique([companyId, jobNumber])
  @@unique([companyId, schedulingIdempotencyKey])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, scheduledStart])
  @@index([companyId, customerId])
  @@index([companyId, propertyId])
  @@index([companyId, playbookId])
  @@index([companyId, serviceTypeId])
  @@index([companyId, serviceTypeId, completedAt])
  @@index([companyId, jobType, completedAt])
  @@index([companyId, sourceSystem, externalId])
  @@index([companyId, importSessionId])
  @@index([companyId, scheduleLocked])
  @@index([companyId, projectId, scheduledStart])
  @@index([companyId, projectPhaseId])
}

