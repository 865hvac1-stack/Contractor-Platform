  assignedTo User?   @relation("CompanyTaskAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdBy  User?   @relation("CompanyTaskCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, status, dueAt])
  @@index([companyId, assignedToUserId])
}

model MetricSnapshot {
