model AIActionDraft {
  id         String    @id @default(cuid())
  companyId  String
  userId     String
  actionType String
  status     String    @default("DRAFT")
  payload    Json
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
}

enum AIActionLevel {
  READ
  PREPARE
  EXECUTE
}

enum AIActionRisk {
  LOW
  MEDIUM
  HIGH
}

enum AIActionRequestStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  EXECUTING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  CANCELED
  EXPIRED
}

enum AIActionTargetStatus {
  PENDING
  EXCLUDED
  EXECUTED
  SKIPPED
  FAILED
}

model AIActionRequest {
  id                   String                 @id @default(cuid())
  companyId            String
  requestedByUserId    String
  conversationId       String?
  approvedByUserId     String?
  actionKey            String
  actionVersion        Int                    @default(1)
  level                AIActionLevel
  riskLevel            AIActionRisk
  status               AIActionRequestStatus  @default(DRAFT)
  title                String
  summary              String                 @db.Text
  input                Json
  preview              Json
  criteria             Json?
  estimatedImpactCents Int?
  targetCount          Int                    @default(0)
  executedCount        Int                    @default(0)
  skippedCount         Int                    @default(0)
  failedCount          Int                    @default(0)
  provider             String?
  executionMode        String?
  idempotencyKey       String
  failureReason        String?
  expiresAt            DateTime
  approvedAt           DateTime?
  executedAt           DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestedBy User            @relation("AIActionRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  approvedBy  User?           @relation("AIActionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  conversation AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  targets     AIActionTarget[]

  @@unique([companyId, idempotencyKey])
  @@index([companyId, status, createdAt])
  @@index([companyId, conversationId])
  @@index([companyId, actionKey])
}

model AIActionTarget {
  id               String               @id @default(cuid())
  companyId        String
  requestId        String
  recordType       String
  recordId         String
  customerId       String?
  customerName     String?
  amountCents      Int?
  daysValue        Int?
  channel          String?
  recipient        String?
  draftMessage     String?              @db.Text
  reason           String?
  payload          Json?
  status           AIActionTargetStatus @default(PENDING)
  skipReason       String?
  failureReason    String?
  provider         String?
  providerResultId String?
  executedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  request AIActionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, requestId])
  @@index([companyId, recordType, recordId])
  @@index([companyId, status])
}

model CompanyTask {
