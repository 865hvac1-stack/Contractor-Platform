enum ReceiptProcessingStatus {
  UPLOADED
  PROCESSING
  REVIEW_REQUIRED
  CONFIRMED
  FAILED
}

enum ReceiptAssignment {
  UNASSIGNED
  JOB
  VEHICLE
  OVERHEAD
  INVENTORY
}

enum ReceiptDuplicateStatus {
  NONE
  POSSIBLE
}

enum JobCostCategory {
  EQUIPMENT
  MATERIALS
  LABOR
  SUBCONTRACTOR
  PERMIT
  FUEL
  RENTAL
  INVENTORY
  OTHER
}

enum JobCostSource {
  RECEIPT
  EXPENSE
  MANUAL
  LABOR
  INVENTORY
  IMPORTED
}

enum QuickBooksInvoiceTrigger {
  MANUAL_ONLY
  WHEN_CREATED
  WHEN_SENT
  WHEN_JOB_COMPLETED
  WHEN_PAYMENT_RECEIVED
}

enum QuickBooksSyncStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
  REAUTH_REQUIRED
  NEEDS_REVIEW
}

enum PricebookItemType {
  SERVICE
  PRODUCT
  MATERIAL
  ADD_ON
  MEMBERSHIP
  BUNDLE
  OTHER
}

enum CustomerMembershipStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum CompensationRuleType {
  FLAT_AMOUNT
  PERCENT_OF_SALE
  PERCENT_OF_GROSS_PROFIT
  TIERED
  THRESHOLD_BONUS
}

enum CompensationTrigger {
  PRICEBOOK_ITEM_SOLD
  MEMBERSHIP_SOLD
  ESTIMATE_APPROVED
  INVOICE_PAID
  JOB_COMPLETED
  REVENUE_THRESHOLD
  MARGIN_THRESHOLD
}

enum CompensationStatus {
  PENDING
  QUALIFIED
  APPROVED
  PAID
  VOIDED
}

enum PaymentMethod {
  CASH
  CHECK
  CREDIT_CARD
  ACH
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  BOOKED
  ESTIMATE_SCHEDULED
  ESTIMATE_SENT
  WON
  LOST
  SPAM
}

enum LeadSource {
  GOOGLE_BUSINESS_PROFILE
  GOOGLE_LSA
  GOOGLE_ADS
  FACEBOOK
  INSTAGRAM
  WEBSITE
  PHONE
  SMS
  EMAIL
  REFERRAL
  REPEAT_CUSTOMER
  ORGANIC_SEARCH
  DIRECT
  MANUAL
  OTHER
  TIKTOK
  LINKEDIN
  YOUTUBE
  META_ADS
}

enum IntegrationStatus {
  NOT_CONNECTED
  CONNECTING
  SELECT_ACCOUNT
  CONNECTED
  SYNCING
