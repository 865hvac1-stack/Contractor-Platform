generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS — extensible string enums via Prisma; new values via migration
// ============================================================

enum CompanyStatus {
  ACTIVE
  ONBOARDING
  SUSPENDED
  INACTIVE
}

enum Industry {
  HVAC
  PLUMBING
  ELECTRICAL
  ROOFING
  POOL_SERVICE
  EXCAVATION
  CONCRETE
  LANDSCAPING
  GENERAL_CONTRACTOR
  OTHER
}

enum CompanyRole {
  COMPANY_OWNER
  ADMIN
  OFFICE
  DISPATCHER
  SALES
  TECHNICIAN
  INSTALLER
  MANAGER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  LEAD
  ARCHIVED
}

enum PreferredContactMethod {
  PHONE
  TEXT
  EMAIL
  ANY
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  MULTI_FAMILY
  OTHER
}

enum JobStatus {
  NEW
  UNSCHEDULED
  SCHEDULED
  DISPATCHED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELED
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum EstimateStatus {
  DRAFT
  SENT
  VIEWED
  APPROVED
  DECLINED
  EXPIRED
  CANCELED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  POSTED
}

enum ExpenseCategory {
  MATERIALS
  EQUIPMENT
  FUEL
  SUBCONTRACTOR
  PERMITS
  TOOLS
  VEHICLE
  OFFICE
  ADVERTISING
  INSURANCE
  OTHER
}

enum ReceiptProcessingStatus {
  UPLOADED
  PROCESSING
  REVIEW_REQUIRED
  CONFIRMED
  FAILED
}

enum PaymentMethod {
  CASH
  CHECK
  CREDIT_CARD
  ACH
  OTHER
}

// ============================================================
// PLATFORM / AUTH
// ============================================================

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  isPlatformAdmin Boolean  @default(false)
  emailVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships          Membership[]
  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  auditLogs            AuditLog[]           @relation("AuditActor")
  assignedJobs         JobAssignment[]
  expensesCreated      Expense[]            @relation("ExpenseCreator")
  invitedMemberships   Membership[]         @relation("MembershipInviter")

  @@index([email])
  @@index([isPlatformAdmin])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Company {
  id            String        @id @default(cuid())
  businessName  String
  legalName     String?
  tradeName     String?
  industry      Industry      @default(HVAC)
  phone         String?
  email         String?
  website       String?
  address       String?
  city          String?
  state         String?
  zip           String?
  timezone      String        @default("America/New_York")
  logoUrl       String?
  primaryColor  String?       @default("#0F766E")
  status        CompanyStatus @default(ONBOARDING)
  companySize   String?
  serviceArea   String?
  onboardingStep Int          @default(0)
  suspendedAt   DateTime?
  suspendedReason String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  memberships Membership[]
  customers   Customer[]
  properties  Property[]
  jobs        Job[]
  estimates   Estimate[]
  invoices    Invoice[]
  expenses    Expense[]
  receipts    Receipt[]
  equipment   Equipment[]
  auditLogs   AuditLog[]
  numberSequences NumberSequence[]

  @@index([status])
  @@index([industry])
  @@index([createdAt])
}

model Membership {
  id          String           @id @default(cuid())
  companyId   String
  userId      String
  role        CompanyRole
  status      MembershipStatus @default(ACTIVE)
  invitedById String?
  invitedAt   DateTime?
  joinedAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("MembershipInviter", fields: [invitedById], references: [id])

  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId, role])
  @@index([companyId, status])
}

model NumberSequence {
  id        String @id @default(cuid())
  companyId String
  kind      String // JOB | ESTIMATE | INVOICE
  prefix    String
  nextValue Int    @default(1)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, kind])
}

// ============================================================
// CRM
// ============================================================

model Customer {
  id                     String                 @id @default(cuid())
  companyId              String
  firstName              String
  lastName               String
  businessName           String?
  email                  String?
  phone                  String?
  secondaryPhone         String?
  preferredContactMethod PreferredContactMethod @default(ANY)
  notes                  String?
  status                 CustomerStatus         @default(ACTIVE)
  tags                   String[]               @default([])
  source                 String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  properties Property[]
  jobs       Job[]
  estimates  Estimate[]
  invoices   Invoice[]
  expenses   Expense[]
  equipment  Equipment[]

  @@index([companyId])
  @@index([companyId, lastName, firstName])
  @@index([companyId, status])
  @@index([companyId, email])
  @@index([companyId, phone])
}

model Property {
  id           String       @id @default(cuid())
  companyId    String
  customerId   String
  name         String?
  address      String
  city         String
  state        String
  zip          String
  propertyType PropertyType @default(RESIDENTIAL)
  accessNotes  String?
  gateCodeNotes String? // treat as sensitive operational note
  isPrimary    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobs      Job[]
  estimates Estimate[]
  invoices  Invoice[]
  equipment Equipment[]

  @@index([companyId])
  @@index([companyId, customerId])
  @@index([customerId])
}

model Equipment {
  id          String   @id @default(cuid())
  companyId   String
  customerId  String?
  propertyId  String?
  name        String
  manufacturer String?
  model       String?
  serialNumber String?
  installDate DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, customerId])
  @@index([companyId, propertyId])
}

// ============================================================
// JOBS
// ============================================================

model Job {
  id                  String      @id @default(cuid())
  companyId           String
  customerId          String
  propertyId          String
  jobNumber           String
  jobType             String?
  trade               Industry?
  status              JobStatus   @default(NEW)
  priority            JobPriority @default(NORMAL)
  source              String?
  description         String?
  internalNotes       String?
  customerNotes       String?
  scheduledStart      DateTime?
  scheduledEnd        DateTime?
  arrivalWindowStart  DateTime?
  arrivalWindowEnd    DateTime?
  completedAt         DateTime?
  // Financial readiness (cents) — populated as invoices/expenses link
  // Do not invent values; calculated from related records when available
  estimateId          String?     @unique
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer        @relation(fields: [customerId], references: [id])
  property   Property        @relation(fields: [propertyId], references: [id])
  estimate   Estimate?       @relation("JobEstimate", fields: [estimateId], references: [id])
  estimates  Estimate[]      @relation("EstimateOptionalJob")
  invoices   Invoice[]
  expenses   Expense[]
  assignments JobAssignment[]

  @@unique([companyId, jobNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, scheduledStart])
  @@index([companyId, customerId])
  @@index([companyId, propertyId])
}

model JobAssignment {
  id         String   @id @default(cuid())
  jobId      String
  userId     String
  assignedAt DateTime @default(now())

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
  @@index([jobId])
}

// ============================================================
// ESTIMATES
// ============================================================

model Estimate {
  id             String         @id @default(cuid())
  companyId      String
  customerId     String
  propertyId     String?
  jobId          String?
  estimateNumber String
  status         EstimateStatus @default(DRAFT)
  issueDate      DateTime       @default(now())
  expirationDate DateTime?
  // Money in integer cents
  subtotalCents  Int            @default(0)
  taxCents       Int            @default(0)
  totalCents     Int            @default(0)
  notes          String?
  followUpAt     DateTime?
  approvedAt     DateTime?
  declinedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer        @relation(fields: [customerId], references: [id])
  property  Property?       @relation(fields: [propertyId], references: [id])
  job       Job?            @relation("EstimateOptionalJob", fields: [jobId], references: [id])
  linkedJob Job?            @relation("JobEstimate")
  lineItems EstimateLineItem[]

  @@unique([companyId, estimateNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, followUpAt])
}

model EstimateLineItem {
  id          String  @id @default(cuid())
  estimateId  String
  name        String
  description String?
  quantity    Decimal @db.Decimal(12, 3)
  unitPriceCents Int
  costCents   Int?
  taxable     Boolean @default(true)
  category    String?
  sortOrder   Int     @default(0)

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
}

// ============================================================
// INVOICES
// ============================================================

model Invoice {
  id             String        @id @default(cuid())
  companyId      String
  customerId     String
  propertyId     String?
  jobId          String?
  invoiceNumber  String
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @default(now())
  dueDate        DateTime?
  subtotalCents  Int           @default(0)
  taxCents       Int           @default(0)
  totalCents     Int           @default(0)
  amountPaidCents Int          @default(0)
  balanceCents   Int           @default(0)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer          @relation(fields: [customerId], references: [id])
  property  Property?         @relation(fields: [propertyId], references: [id])
  job       Job?              @relation(fields: [jobId], references: [id])
  lineItems InvoiceLineItem[]
  payments  Payment[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, dueDate])
}

model InvoiceLineItem {
  id             String  @id @default(cuid())
  invoiceId      String
  name           String
  description    String?
  quantity       Decimal @db.Decimal(12, 3)
  unitPriceCents Int
  taxable        Boolean @default(true)
  category       String?
  sortOrder      Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// Payment records — gateway-agnostic; Stripe etc. can plug in later via externalRef
model Payment {
  id             String         @id @default(cuid())
  companyId      String
  invoiceId      String
  amountCents    Int
  method         PaymentMethod  @default(OTHER)
  status         String         @default("RECORDED") // RECORDED | PENDING | FAILED | REFUNDED
  paidAt         DateTime       @default(now())
  externalRef    String? // future Stripe payment intent id etc.
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([invoiceId])
}

// ============================================================
// EXPENSES / RECEIPTS
// ============================================================

model Expense {
  id              String          @id @default(cuid())
  companyId       String
  vendor          String?
  date            DateTime        @default(now())
  amountCents     Int
  taxCents        Int             @default(0)
  category        ExpenseCategory @default(OTHER)
  description     String?
  paymentMethod   PaymentMethod?
  jobId           String?
  customerId      String?
  status          ExpenseStatus   @default(DRAFT)
  createdById     String
  receiptId       String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy User     @relation("ExpenseCreator", fields: [createdById], references: [id])
  receipt   Receipt? @relation(fields: [receiptId], references: [id])

  @@index([companyId])
  @@index([companyId, category])
  @@index([companyId, date])
  @@index([companyId, jobId])
  @@index([companyId, status])
}

model Receipt {
  id                 String                  @id @default(cuid())
  companyId          String
  fileName           String
  filePath           String
  mimeType           String
  fileSizeBytes      Int
  processingStatus   ReceiptProcessingStatus @default(UPLOADED)
  // Future AI extraction fields — null until a real extractor runs
  extractedMerchant  String?
  extractedDate      DateTime?
  extractedTotalCents Int?
  extractedTaxCents  Int?
  suggestedCategory  ExpenseCategory?
  suggestedJobId     String?
  extractionError    String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expense Expense?

  @@index([companyId])
  @@index([companyId, processingStatus])
}

// ============================================================
// AUDIT
// ============================================================

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  actor   User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
  @@index([actorId])
  @@index([action])
}
