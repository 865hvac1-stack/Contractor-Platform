# Application
APP_URL="http://127.0.0.1:43123"
NODE_ENV="production"

# Database — Railway Postgres plugin injects this when linked
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Session signing secret — generate a long random string (32+ characters)
SESSION_SECRET="replace-with-long-random-secret-min-32-chars"

# Provider token encryption (AES-256-GCM). Prefer INTEGRATION_ENCRYPTION_KEY.
# If unset, INTEGRATION_SECRET then SESSION_SECRET is used (32+ characters).
# Never commit real tokens.
# INTEGRATION_ENCRYPTION_KEY="replace-with-32-plus-character-secret"
# INTEGRATION_SECRET="replace-with-32-plus-character-secret"

# Google OAuth (shared by Business Profile, Ads, LSA, Analytics, Search Console, YouTube)
# Callback: ${APP_URL}/api/integrations/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_ADS_DEVELOPER_TOKEN=""
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

# Meta / Facebook / Instagram / Ads
# Callback: ${APP_URL}/api/integrations/meta/callback
# META_APP_ID=""
# META_APP_SECRET=""
# META_WEBHOOK_VERIFY_TOKEN=""

# TikTok Login Kit
# Callback: ${APP_URL}/api/integrations/tiktok/callback
# TIKTOK_CLIENT_KEY=""
# TIKTOK_CLIENT_SECRET=""

# LinkedIn
# Callback: ${APP_URL}/api/integrations/linkedin/callback
# LINKEDIN_CLIENT_ID=""
# LINKEDIN_CLIENT_SECRET=""

# Twilio (phone / SMS) — do not provision numbers without these
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""

# Resend (transactional email) — technician / team invite emails
# RESEND_API_KEY=""
# EMAIL_FROM="ContractorYou <noreply@mail.contractoryou.com>"
# RESEND_FROM=""

# Twilio (optional company calling / On My Way SMS). Without these, Call/Text
# fall back to the customer number and On My Way still updates job state.
# TWILIO_FROM_NUMBER=""

# Optional webhook HMAC for /api/webhooks/[provider]
# INTEGRATION_WEBHOOK_SECRET=""

# ContractorYou Intelligence (server-side only). Contractors do not enter this.
# OPENAI_API_KEY=""

# Google Maps Directions / waypoint optimization (server-side only).
# Without this, Dispatch shows "Route optimization is not configured"
# and never invents mileage or time savings.
# GOOGLE_MAPS_API_KEY=""
# GOOGLE_ROUTES_API_KEY=""

# QuickBooks Online (Intuit OAuth). Never expose these to the browser.
# Callback: ${APP_URL}/api/integrations/quickbooks/callback
# QUICKBOOKS_CLIENT_ID=""
# QUICKBOOKS_CLIENT_SECRET=""
# QUICKBOOKS_ENVIRONMENT="sandbox"
# QUICKBOOKS_REDIRECT_URI=""

# ContractorYou Payments — Stripe Connect (optional).
# Without these, Settings → Payments shows "Payments not configured"
# and lists the missing names. The app still boots. Manual cash/check still work.
# Never store raw card numbers, CVV, or bank credentials.
# Use Stripe TEST keys first (sk_test_ / pk_test_ / whsec_...).
# STRIPE_SECRET_KEY=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# Optional Connect client id (embedded Account Sessions do not require it):
# STRIPE_CONNECT_CLIENT_ID=""
# Future platform fee in basis points. Default 0 — do not invent fees.
# STRIPE_PLATFORM_FEE_BPS="0"
# Canonical webhook: ${APP_URL}/api/webhooks/stripe
# Legacy webhook (same handler): ${APP_URL}/api/payments/stripe
# Required events: account.updated, payment_intent.succeeded,
# payment_intent.processing, payment_intent.payment_failed, payment_intent.canceled,
# checkout.session.completed, charge.refunded, refund.updated, charge.dispute.created
# Enable Connect events on connected accounts in the Stripe Dashboard.

# HighLevel / GoHighLevel (preferred marketing + communications provider)
# Marketplace OAuth is the production multi-tenant path.
# Callback: ${APP_URL}/api/integrations/oauth/callback
# Webhook: ${APP_URL}/api/webhooks/highlevel
# HIGHLEVEL_CLIENT_ID=""
# HIGHLEVEL_CLIENT_SECRET=""
# HIGHLEVEL_REDIRECT_URI=""
# A location Private Integration Token can connect 865 HVAC for testing
# without Marketplace approval. Paste it in Settings → HighLevel — never commit it.

# File uploads — local path or Railway volume mount
UPLOAD_DIR="./uploads"

# Development seed ONLY — never set ALLOW_SEED=true in production
ALLOW_SEED="false"
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""
SEED_PLATFORM_ADMIN_EMAIL=""
SEED_PLATFORM_ADMIN_PASSWORD=""
